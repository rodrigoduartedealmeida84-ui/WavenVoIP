{
  "Urls": "http://127.0.0.1:5005",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/opt/waven-api/logs/waven-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "WavenApi": {
    "DbPath": "/opt/waven-api/data/waven.db",
    "MaxPayloadBytes": 1048576,
    "BearerToken": "",
    "RecordingsPath": "/var/spool/asterisk/monitor",
    "MySql": {
      "Host": "127.0.0.1",
      "Port": 3306,
      "Database": "asteriskcdrdb",
      "Table": "cdr",
      "User": "",
      "Password": "",
      "ConnectionTimeoutSeconds": 10
    },
    "Ami": {
      "Host": "127.0.0.1",
      "Port": 5038,
      "User": "",
      "Password": "",
      "ConnectTimeoutMs": 5000
    }
  }
}
