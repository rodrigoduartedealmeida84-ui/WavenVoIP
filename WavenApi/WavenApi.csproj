<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WavenApi</AssemblyName>
    <RootNamespace>WavenApi</RootNamespace>
    <!-- Publish: dotnet publish -r linux-x64 -p:SelfContained=true -p:PublishSingleFile=true -->

  </PropertyGroup>
  <ItemGroup>
    <!-- Nunca publicar o config de producao real — apenas o .example vai no ZIP -->
    <Content Update="appsettings.Production.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- v2.4.2 — PINNED (não "8.*"): 8.0.30+ traz SQLitePCLRaw 2.1.12, cujo
         libe_sqlite3.so linux-x64 exige GLIBC_2.34. O servidor de produção (Rocky
         Linux 8.10) só tem GLIBC 2.28 — a versão flutuante quebrou o deploy em
         produção (crash loop, "GLIBC_2.33 not found") até ser revertida. 8.0.28 usa
         SQLitePCLRaw 2.1.6, que exige no máximo GLIBC_2.28 — compatível. Não trocar
         para "8.*"/floating de novo sem testar contra o glibc real do servidor. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.28" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.28">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MySqlConnector" Version="2.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.*" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.*" />
  </ItemGroup>
</Project>
