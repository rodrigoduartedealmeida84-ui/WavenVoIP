<Project Sdk="Microsoft.NET.Sdk">
  <!-- v2.6.1 — testes do microfone (identificação de headset, detector de voz, proxy de áudio,
       telas). Nada é publicado, nada vai ao servidor; o modo "dispositivos" só LÊ o áudio do
       Windows (e abre o microfone por poucos segundos, sem gravar). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\WavenVoIP\WavenVoIP.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\WavenVoIP\Assets\**\*.ico;..\WavenVoIP\Assets\**\*.png" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
