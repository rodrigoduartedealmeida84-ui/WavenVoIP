<Window x:Class="WavenUpdater.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WavenVoIP — Atualizando"
        Width="460" Height="260"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Closing="Window_Closing">

    <Border Background="#110A20" CornerRadius="12" BorderBrush="#3B0764" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#7C3AED" BlurRadius="28" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="34"/>
            </Grid.RowDefinitions>

            <!-- Drag header -->
            <Border Grid.Row="0" Background="#0D0617" CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="Header_MouseDown">
                <DockPanel Margin="14,0">
                    <!-- Logo -->
                    <Image Source="/Assets/waven_logo_light.png"
                           Height="28" Stretch="Uniform"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           DockPanel.Dock="Left" Margin="0,0,10,0"/>
                    <TextBlock Text="— Atualizando..."
                               Foreground="#9CA3AF" FontSize="12"
                               VerticalAlignment="Center"
                               DockPanel.Dock="Left"/>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="22,16,22,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Status text -->
                <TextBlock x:Name="txtStatus" Grid.Row="0"
                           Text="Preparando..."
                           Foreground="#E5E7EB"
                           FontSize="13"
                           TextWrapping="Wrap"/>

                <!-- Progress bar -->
                <ProgressBar x:Name="progressBar" Grid.Row="2"
                             Height="8"
                             Minimum="0" Maximum="100"
                             Value="0"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Grid>
                                            <Border Background="#1E1035" CornerRadius="4"/>
                                            <!-- Determinate fill -->
                                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#6D28D9" Offset="0"/>
                                                        <GradientStop Color="#A855F7" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <!-- Indeterminate fill (breathing) -->
                                            <Border x:Name="IndeterminateFill" CornerRadius="4" Visibility="Collapsed">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#4C1D95" Offset="0"/>
                                                        <GradientStop Color="#7C3AED" Offset="0.5"/>
                                                        <GradientStop Color="#4C1D95" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation
                                                                    Storyboard.TargetProperty="Opacity"
                                                                    From="0.35" To="1.0"
                                                                    Duration="0:0:0.85"
                                                                    AutoReverse="True"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                            </Border>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsIndeterminate" Value="True">
                                                <Setter TargetName="PART_Indicator"   Property="Visibility" Value="Collapsed"/>
                                                <Setter TargetName="IndeterminateFill" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <!-- Size / percent info -->
                <DockPanel Grid.Row="4">
                    <TextBlock x:Name="txtVersion"
                               Foreground="#6B7280" FontSize="11"
                               DockPanel.Dock="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtPercent"
                               Foreground="#9CA3AF" FontSize="11"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <!-- Retry / error hint -->
                <TextBlock x:Name="txtHint" Grid.Row="6"
                           Foreground="#6D28D9" FontSize="10"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"/>

                <!-- Error action buttons (shown only when update fails) -->
                <StackPanel x:Name="panelErrorButtons" Grid.Row="8"
                            Orientation="Horizontal" Visibility="Collapsed">
                    <Button x:Name="btnAbrirApp"
                            Content="Abrir WavenVoIP"
                            Height="28" Padding="10,0" FontSize="10"
                            Background="#1A0F35" Foreground="#A78BFA"
                            BorderBrush="#4C1D95" BorderThickness="1"
                            Cursor="Hand" Margin="0,0,8,0"
                            Click="BtnAbrirApp_Click"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="14,0,14,8">
                <Grid>
                    <TextBlock Text="Não feche esta janela durante a atualização"
                               Foreground="#4B5563" FontSize="10"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <Button x:Name="btnCopiarLog"
                            Content="Copiar log"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Height="22" Padding="8,0" FontSize="10"
                            Background="#1E1035" Foreground="#9CA3AF"
                            BorderBrush="#3B0764" BorderThickness="1"
                            Cursor="Hand"
                            Click="BtnCopiarLog_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
