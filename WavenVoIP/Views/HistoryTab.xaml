<UserControl x:Class="WavenVoIP.Views.HistoryTab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <DataGrid x:Name="gridHistorico" AutoGenerateColumns="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="120"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="180"/>
                <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora}" Width="170"/>
                <DataGridTextColumn Header="Duração" Binding="{Binding Duracao}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
