                                                        <TextBlock Text="{Binding TipoTexto}" Foreground="{Binding CorTipo}" FontWeight="SemiBold" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip="{Binding TipoTextoDetalhado}"/>
