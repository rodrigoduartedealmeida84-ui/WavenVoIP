                    <TabItem>
                        <Grid Background="{StaticResource WindowBgBrush}">
                            <!-- Redirect panel — settings are managed in SettingsWindow -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="64"
                                           HorizontalAlignment="Center" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,16"/>
                                <TextBlock Text="Configurações" FontSize="24" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                <TextBlock Text="Gerencie servidor SIP, AMI, CDR, áudio e WhatsApp."
                                           Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,0,0,28"/>
                                <Button Content="Abrir Configurações" Width="240" Height="48"
                                        Style="{StaticResource PrimaryButtonStyle}" Click="BtnConfiguracoes_Click"/>
                                <Button Content="Sair da conta / trocar ramal" Width="240" Height="44" Margin="0,12,0,0"
                                        Background="#FFF1F2" Foreground="#E11D48" BorderBrush="#FFE4E6"
                                        BorderThickness="1" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSairConta_Click"/>
                            </StackPanel>
                            <!-- Hidden legacy controls — kept for code-behind compatibility -->
                            <ScrollViewer Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,0,12,0">
                                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,0,0,14" MaxWidth="760" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <TextBlock Text="Configurações" FontSize="26" FontWeight="Bold"/>
                                            <TextBlock Text="Conta SIP, áudio, WhatsApp, identificação de canais e preferências do softphone." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/>

                                            <TextBlock Text="Conta SIP / Issabel" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <Grid Margin="0,0,0,14">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"><TextBlock Text="Ramal" FontWeight="SemiBold"/><TextBox x:Name="txtCfgRamal" Height="38"/></StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Login/Auth User" FontWeight="SemiBold"/><TextBox x:Name="txtCfgLogin" Height="38"/></StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10"><TextBlock Text="Senha" FontWeight="SemiBold"/><PasswordBox x:Name="txtCfgSenha" Height="38"/></StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10"><TextBlock Text="Servidor SIP" FontWeight="SemiBold"/><TextBox x:Name="txtCfgServidor" Height="38"/></StackPanel>
                                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Porta" FontWeight="SemiBold"/><TextBox x:Name="txtCfgPorta" Height="38"/></StackPanel>
                                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0"><TextBlock Text="Domínio" FontWeight="SemiBold"/><TextBox x:Name="txtCfgDominio" Height="38"/></StackPanel>
                                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Proxy SIP" FontWeight="SemiBold"/><TextBox x:Name="txtCfgProxy" Height="38"/></StackPanel>
                                                <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,10,10,0"><TextBlock Text="Nome do ramal" FontWeight="SemiBold"/><TextBox x:Name="txtCfgRamalNome" Height="38" ToolTip="Ex.: Rodrigo — exibido no botão Online/Offline"/></StackPanel>
                                            </Grid>

                                            <Border Padding="14" CornerRadius="16" Background="#F8FAFC" BorderBrush="#E7EAF3" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Transferências" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock Text="Controle se o operador pode transferir chamadas para números externos. Conferência continua permitindo números externos." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                                    <CheckBox x:Name="chkPermitirTransferenciaExterna" Content="Permitir transferência para números externos" IsChecked="True" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="14" CornerRadius="16" Background="#F8FAFC" BorderBrush="#E7EAF3" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Ramais do Issabel via AMI" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock Text="Sincroniza automaticamente a lista de ramais do Issabel e salva/atualiza nos contatos. No Issabel, crie um usuário AMI com permissão system, command e reporting." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                                    <CheckBox x:Name="chkAmiAtivo" Content="Ativar sincronização AMI" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"><TextBlock Text="Host AMI" FontWeight="SemiBold"/><TextBox x:Name="txtAmiHost" Height="36" Text="191.252.202.208"/></StackPanel>
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Porta AMI" FontWeight="SemiBold"/><TextBox x:Name="txtAmiPorta" Height="36" Text="5038"/></StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10"><TextBlock Text="Usuário AMI" FontWeight="SemiBold"/><TextBox x:Name="txtAmiUsuario" Height="36" Text="waven"/></StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Senha AMI" FontWeight="SemiBold"/><PasswordBox x:Name="txtAmiSenha" Height="36"/></StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="Atualizar a cada" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                            <ComboBox x:Name="cmbAmiIntervalo" Height="36">
                                                                <ComboBoxItem Content="Manual"    Tag="0"  IsSelected="True"/>
                                                                <ComboBoxItem Content="1 minuto"  Tag="1"/>
                                                                <ComboBoxItem Content="5 minutos" Tag="5"/>
                                                                <ComboBoxItem Content="15 minutos" Tag="15"/>
                                                                <ComboBoxItem Content="30 minutos" Tag="30"/>
                                                                <ComboBoxItem Content="1 hora"    Tag="60"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,0">
                                                            <Button x:Name="btnSincAmiAgora" Content="Sincronizar AMI agora" Height="40" Margin="0,20,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSincronizarRamaisAmi_Click"/>
                                                            <TextBlock x:Name="txtAmiSyncStatus" Text="" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Configuração Centralizada da Empresa -->
                                            <Border Padding="14" CornerRadius="16" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="Configuração da Empresa" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        <Border Background="#D1FAE5" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="Auto-sync" FontSize="11" FontWeight="SemiBold" Foreground="#065F46"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="Configurações de WhatsApp e CDR são aplicadas automaticamente via arquivo remoto da empresa. Nunca sobrescreve seus dados SIP, contatos pessoais ou favoritos." Foreground="#166534" TextWrapping="Wrap" Margin="0,0,0,12" FontSize="12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                <TextBlock Text="Versão aplicada: " FontSize="12" Foreground="#374151"/>
                                                                <TextBlock x:Name="txtCompanyConfigVersion" Text="—" FontSize="12" FontWeight="SemiBold" Foreground="#065F46"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="Última sync: " FontSize="12" Foreground="#374151"/>
                                                                <TextBlock x:Name="txtCompanyConfigLastSync" Text="—" FontSize="12" Foreground="#6B7280"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <Button x:Name="btnSincronizarConfigEmpresa" Content="↻ Sincronizar agora" Height="36" Width="160" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSincronizarConfigEmpresa_Click"/>
                                                            <TextBlock x:Name="txtCompanyConfigStatus" Text="" FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="14" CornerRadius="16" Background="#F8FAFC" BorderBrush="#E7EAF3" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="WhatsApp / Waven Chat" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock Text="Configure a API ZPRO/Waven Chat usada nos botões de WhatsApp dos contatos, histórico e chamada." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                            <TextBlock Text="URL da API" FontWeight="SemiBold"/>
                                                            <TextBox x:Name="txtWhatsApiUrl" Height="36"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                            <TextBlock Text="Bearer Token" FontWeight="SemiBold"/>
                                                            <PasswordBox x:Name="txtWhatsBearerToken" Height="36"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                                            <TextBlock Text="Número de teste" FontWeight="SemiBold"/>
                                                            <TextBox x:Name="txtWhatsNumeroTeste" Height="36"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                                                            <TextBlock Text="Mensagem de teste" FontWeight="SemiBold"/>
