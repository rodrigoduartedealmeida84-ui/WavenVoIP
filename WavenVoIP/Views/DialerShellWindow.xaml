                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="14" CornerRadius="16" Background="#F8FAFC" BorderBrush="#E7EAF3" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Canais de entrada do Issabel" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock Text="O app tenta identificar pelo DID/DDR ou nome da rota no SIP. Se o Issabel não enviar o DID para o ramal, o canal ficará como Entrada não identificada até o PBX encaminhar esse dado no cabeçalho." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <TextBlock Grid.Row="0" Text="Operadora" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCanalOperadora" Height="36" Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="1" Text="0800" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCanal0800" Height="36" Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="2" Text="WhatsApp TIM" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="txtCanalTim" Height="36" Margin="0,0,0,8"/>
                                                        <TextBlock Grid.Row="3" Text="WhatsApp Vivo" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="txtCanalVivo" Height="36"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="14" CornerRadius="16" Background="#F8FAFC" BorderBrush="#E7EAF3" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Áudio e toque" FontSize="18" FontWeight="Bold"/>
                                                    <TextBlock Text="Escolha microfone, alto-falante e toque de chamada recebido." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                                            <TextBlock Text="Microfone" FontWeight="SemiBold"/>
                                                            <ComboBox x:Name="cmbCfgMicrofone" Height="38" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                                            <TextBlock Text="Alto-falante" FontWeight="SemiBold"/>
                                                            <ComboBox x:Name="cmbCfgAltoFalante" Height="38" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10">
                                                            <TextBlock Text="Toque de chamada" FontWeight="SemiBold"/>
                                                            <Grid Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                                                <TextBox x:Name="txtCfgToque" Height="38" VerticalContentAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="Trocar" Height="38" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTrocarToquePrincipal_Click"/>
                                                            </Grid>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                                            <TextBlock Text="Dispositivo de toque" FontWeight="SemiBold"/>
                                                            <Grid Margin="0,4,0,0">
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                                                                <ComboBox x:Name="cmbCfgDispToque" Height="38" VerticalContentAlignment="Center"/>
                                                                <Button Grid.Column="1" Content="Testar toque" Height="38" Margin="8,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTestarToque_Click"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                    <CheckBox x:Name="chkCfgInvadirTela" Content="Tela de chamada recebida em destaque" Margin="0,12,0,0"/>
                                                    <CheckBox x:Name="chkToqueSpeakerPrincipal" Content="Tocar chamadas recebidas no alto-falante principal (nunca no headset automático)" Margin="0,6,0,0" IsChecked="True"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="14" CornerRadius="16" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Integrações" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Conecte o Google Contacts para importar contatos automaticamente." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                                    <!-- Google -->
                                                    <TextBlock Text="Google Contacts" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                                    <Grid Margin="0,0,0,10">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Border x:Name="bolinhaGoogle" Width="8" Height="8" CornerRadius="4" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                            <TextBlock x:Name="txtGoogleStatus" Text="Google: desconectado" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button x:Name="btnConectarGoogle" Content="Conectar" Height="34" MinWidth="90" Padding="10,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnConectarGoogle_Click" Margin="0,0,6,0" FontSize="12" ToolTip="Autenticar com Google e importar contatos"/>
                                                            <Button x:Name="btnSincronizarGoogle" Content="Sincronizar" Height="34" MinWidth="90" Padding="10,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSincronizarGoogle_Click" Margin="0,0,6,0" FontSize="12" IsEnabled="False" ToolTip="Sincronizar contatos Google agora"/>
                                                            <Button x:Name="btnDesconectarGoogle" Content="Desconectar" Height="34" MinWidth="90" Padding="10,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnDesconectarGoogle_Click" FontSize="12" IsEnabled="False" ToolTip="Revogar acesso Google"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,14">
                                                        <TextBlock Text="Sincronização automática:" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <ComboBox x:Name="cmbGoogleSyncInterval" Height="32" Width="160" FontSize="12" SelectedIndex="0" SelectionChanged="CmbGoogleSyncInterval_SelectionChanged">
                                                            <ComboBoxItem Content="Manual" Tag="0"/>
                                                            <ComboBoxItem Content="A cada 5 minutos" Tag="5"/>
                                                            <ComboBoxItem Content="A cada 15 minutos" Tag="15"/>
                                                            <ComboBoxItem Content="A cada 30 minutos" Tag="30"/>
                                                            <ComboBoxItem Content="A cada 60 minutos" Tag="60"/>
                                                        </ComboBox>
                                                    </StackPanel>

                                                    <!-- AMI status -->
                                                    <TextBlock Text="AMI / Issabel" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border x:Name="bolinhaAmiContatos" Width="8" Height="8" CornerRadius="4" Background="#94A3B8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="txtAmiStatusContatos" Text="AMI: aguardando configuração" FontSize="12" Foreground="#334155" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- CDR / Histórico real do Issabel -->
                                            <Border Padding="14" CornerRadius="16" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="CDR — Histórico real do Issabel" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Lê o histórico real de chamadas do banco MySQL do Asterisk/Issabel. Banco padrão: asteriskcdrdb, tabela: cdr." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                    <CheckBox x:Name="chkCdrAtivo" Content="Ativar sincronização CDR" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10"><TextBlock Text="Host MySQL" FontWeight="SemiBold"/><TextBox x:Name="txtCdrHost" Height="36" ToolTip="IP do servidor Issabel"/></StackPanel>
                                                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Porta MySQL" FontWeight="SemiBold"/><TextBox x:Name="txtCdrPorta" Height="36" Text="3306"/></StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10"><TextBlock Text="Banco de dados" FontWeight="SemiBold"/><TextBox x:Name="txtCdrBanco" Height="36" Text="asteriskcdrdb"/></StackPanel>
                                                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Tabela CDR" FontWeight="SemiBold"/><TextBox x:Name="txtCdrTabela" Height="36" Text="cdr"/></StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10"><TextBlock Text="Usuário MySQL" FontWeight="SemiBold"/><TextBox x:Name="txtCdrUsuario" Height="36"/></StackPanel>
                                                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10"><TextBlock Text="Senha MySQL" FontWeight="SemiBold"/><PasswordBox x:Name="txtCdrSenha" Height="36"/></StackPanel>
                                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,10">
                                                            <TextBlock Text="Modo de exibição" FontWeight="SemiBold"/>
                                                            <ComboBox x:Name="cmbHistoricoModo" Height="36" Margin="0,4,0,0">
                                                                <ComboBoxItem Content="Apenas meu ramal" Tag="MeuRamal"/>
                                                                <ComboBoxItem Content="Todos os ramais" Tag="TodosRamais"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,10">
                                                            <TextBlock Text="Sincronização automática" FontWeight="SemiBold"/>
                                                            <ComboBox x:Name="cmbHistoricoSyncInterval" Height="36" Margin="0,4,0,0">
                                                                <ComboBoxItem Content="5 segundos"  Tag="5"/>
                                                                <ComboBoxItem Content="10 segundos" Tag="10"/>
                                                                <ComboBoxItem Content="30 segundos" Tag="30"/>
                                                                <ComboBoxItem Content="1 minuto"    Tag="60"/>
                                                                <ComboBoxItem Content="5 minutos"   Tag="300"/>
                                                            </ComboBox>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Content="Testar conexão CDR" Height="38" MinWidth="160" Padding="12,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTestarConexaoCdr_Click" Margin="0,0,8,0" FontSize="12"/>
                                                        <Button x:Name="btnSincronizarCdrAgoraConfig" Content="Sincronizar agora" Height="38" MinWidth="140" Padding="12,0" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSincronizarCdrAgora_Click" FontSize="12"/>
                                                        <TextBlock x:Name="txtStatusCdrConfig" Text="" VerticalAlignment="Center" FontSize="11" Foreground="#94A3B8" Margin="12,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>

                                            <!-- Gravações de chamadas -->
                                            <Border Padding="14" CornerRadius="16" Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Gravações de chamadas" FontSize="18" FontWeight="Bold" Margin="0,0,0,4"/>
                                                    <TextBlock Text="Configure como o WavenVoIP acessa os arquivos de gravação do Issabel." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                                    <CheckBox x:Name="chkGravacaoAtiva" Content="Ativar busca de gravações" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <TextBlock Text="Tipo de acesso:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                        <ComboBox x:Name="cmbGravacaoTipo" Height="34" Width="180">
                                                            <ComboBoxItem Content="URL base (HTTP)" Tag="URL"/>
                                                            <ComboBoxItem Content="Pasta local / rede" Tag="Local"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <StackPanel Margin="0,0,0,10">
                                                        <TextBlock Text="URL base ou caminho das gravações" FontWeight="SemiBold"/>
                                                        <TextBox x:Name="txtGravacaoUrlBase" Height="36" Margin="0,4,0,0" ToolTip="https://issabel.empresa.com/recordings/ ou \\servidor\gravacoes"/>
                                                    </StackPanel>
                                                    <Button Content="Testar acesso" Height="36" Width="140" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTestarAcessoGravacao_Click" FontSize="12"/>
                                                </StackPanel>
                                            </Border>

                                            <Border Padding="14" CornerRadius="16" Background="#F8FAFC" BorderBrush="#E7EAF3" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Limpeza automática do histórico" FontWeight="Bold"/>
                                                    <TextBlock Text="Apagar chamadas com mais de quantos dias?" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,8"/>
                                                    <DockPanel><TextBox x:Name="txtHistoricoRetencaoDias" Width="80" Height="38" FontSize="15" Text="7" VerticalContentAlignment="Center" TextAlignment="Center"/><TextBlock Text=" dias" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource MutedBrush}"/></DockPanel>
                                                </StackPanel>
                                            </Border>


                                            <!-- ── Diagnóstico / Logs do Sistema ──────────────────────────── -->
                                            <Border Padding="14" CornerRadius="16" Background="#F8FAFC" BorderBrush="#E7EAF3" BorderThickness="1" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <!-- Header -->
                                                    <TextBlock Text="Diagnóstico / Logs do Sistema" FontSize="18" FontWeight="Bold" Margin="0,0,0,2"/>
                                                    <TextBlock Text="Logs em tempo real de todas as integrações. Arquivo físico em %LOCALAPPDATA%\WavenVoIP\Logs\"
                                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>

                                                    <!-- Action row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <CheckBox x:Name="chkLogAutoScroll" Content="Rolagem automática"
                                                                  IsChecked="True" VerticalAlignment="Center"
                                                                  FontSize="12" Margin="0,0,14,0"/>
                                                        <Button x:Name="btnLimparLogsShell" Content="Limpar logs"
                                                                Height="34" Padding="14,0" FontSize="12"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="BtnLimparLogsShell_Click" Margin="0,0,8,0"/>
                                                        <Button x:Name="btnCopiarLogsShell" Content="Copiar logs"
                                                                Height="34" Padding="14,0" FontSize="12"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="BtnCopiarLogsShell_Click" Margin="0,0,8,0"/>
                                                        <Button x:Name="btnAbrirPastaLogs" Content="Abrir pasta de logs"
                                                                Height="34" Padding="14,0" FontSize="12"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Click="BtnAbrirPastaLogs_Click"/>
                                                    </StackPanel>

                                                    <!-- Filter chips -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <Button x:Name="btnLogFiltroTodos"    Content="Todos"    Tag="ALL"    Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0" Click="BtnLogFiltro_Click" Background="#7C3AED" Foreground="White"    BorderThickness="0"/>
                                                        <Button x:Name="btnLogFiltroErros"    Content="Erros"    Tag="ERROR"  Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0" Click="BtnLogFiltro_Click" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"/>
                                                        <Button x:Name="btnLogFiltroUpdater"  Content="Updater"  Tag="update" Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0" Click="BtnLogFiltro_Click" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"/>
                                                        <Button x:Name="btnLogFiltroGoogle"   Content="Google"   Tag="google" Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0" Click="BtnLogFiltro_Click" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"/>
                                                        <Button x:Name="btnLogFiltroAmi"      Content="AMI"      Tag="ami"    Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0" Click="BtnLogFiltro_Click" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"/>
                                                        <Button x:Name="btnLogFiltroWhatsApp" Content="WhatsApp" Tag="whats"  Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0" Click="BtnLogFiltro_Click" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"/>
                                                        <Button x:Name="btnLogFiltroSip"      Content="SIP"      Tag="sip"    Height="28" Padding="10,0" FontSize="11"                   Click="BtnLogFiltro_Click" Background="#F1F5F9" Foreground="#475569" BorderThickness="0"/>
                                                    </StackPanel>

                                                    <!-- Terminal log display -->
                                                    <Border Background="#0F172A" CornerRadius="8" Height="360">
                                                        <ListBox x:Name="listSysLogs"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 VirtualizingPanel.IsVirtualizing="True"
                                                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                                 Padding="4,4">
                                                            <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                    <Setter Property="Padding" Value="2,1"/>
                                                                    <Setter Property="Background" Value="Transparent"/>
                                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                                    <Setter Property="Focusable" Value="False"/>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter Property="Background" Value="#1E293B"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ListBox.ItemContainerStyle>
                                                            <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <TextBlock Text="{Binding Text}"
                                                                               Foreground="{Binding Color}"
                                                                               FontFamily="Consolas"
                                                                               FontSize="11"
                                                                               TextWrapping="NoWrap"/>
                                                                </DataTemplate>
                                                            </ListBox.ItemTemplate>
                                                        </ListBox>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <Button Content="Salvar configurações" Width="220" Height="46" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSalvarPreferencias_Click" HorizontalAlignment="Left"/>
                                                <Button Content="Alterar conta SIP" Width="180" Height="46" Margin="12,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnAlterarContaSip_Click" HorizontalAlignment="Left" ToolTip="Editar ramal, senha e configuração AMI sem sair da conta"/>
                                                <Button Content="Sair da conta / trocar ramal" Width="230" Height="46" Margin="12,0,0,0" Background="#FFF1F2" Foreground="#E11D48" BorderBrush="#FFE4E6" BorderThickness="1" Style="{StaticResource SecondaryButtonStyle}" Click="BtnSairConta_Click" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- Dashboard tab (index 4) -->
                    <TabItem>
                        <local:DashboardControl x:Name="dashboardControl" Margin="0,4,0,0"/>
                    </TabItem>

                </TabControl>
            </Grid>
        <Border x:Name="routeSelectorOverlay" Visibility="Collapsed" Background="#88000000" CornerRadius="18">
            <Grid>
                <Border Width="440" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="24">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#F9F8FF" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.22" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                <Viewbox Width="20" Height="20">
                                    <Path Fill="{StaticResource PrimaryBrush}" Data="M9,3L5,6.99H8V14H10V6.99H13L9,3M16,17.01V10H14V17.01H11L15,21L19,17.01H16Z"/>
                                </Viewbox>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Escolha a saída" FontSize="20" FontWeight="Bold"/>
                                <TextBlock x:Name="txtRouteSelectorNumero" Text="Número:" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                        <Rectangle Height="1" Fill="#EDE9FE" Margin="0,12,0,16"/>
                        <Button Height="54" Margin="0,0,0,8" Background="#F4F1FF" Foreground="#4C1D95" BorderThickness="1" BorderBrush="#DDD6FE" FontWeight="SemiBold" FontSize="15" Style="{StaticResource SecondaryButtonStyle}" Click="RouteOperadora_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#7C3AED" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="1" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                </Border>
                                <TextBlock Text="Operadora" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="54" Margin="0,0,0,8" Background="#F0FDF4" Foreground="#14532D" BorderThickness="1" BorderBrush="#BBF7D0" FontWeight="SemiBold" FontSize="15" Style="{StaticResource SecondaryButtonStyle}" Click="RouteWhatsAppTim_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#16A34A" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="2" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
                                </Border>
                                <TextBlock Text="WhatsApp TIM" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Height="54" Margin="0,0,0,18" Background="#F0FDF4" Foreground="#14532D" BorderThickness="1" BorderBrush="#BBF7D0" FontWeight="SemiBold" FontSize="15" Style="{StaticResource SecondaryButtonStyle}" Click="RouteWhatsAppVivo_Click">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="28" Height="28" CornerRadius="8" Background="#15803D" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="3" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="14"/>
