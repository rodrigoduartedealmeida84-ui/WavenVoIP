<Window x:Class="WavenVoIP.Views.BlindTransferWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar transferência" Height="370" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/Assets/wavenvoip.ico">
    <Grid Margin="18">
        <Border Style="{StaticResource CardStyle}" Padding="22,24,22,22">
            <StackPanel>

                <!-- Title -->
                <TextBlock Text="Transferência cega" FontSize="20" FontWeight="Bold" Margin="0,0,0,18"/>

                <!-- Contact card -->
                <Border Background="#F8FAFC" CornerRadius="14" Padding="16,14"
                        BorderBrush="#E7EAF3" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="borderAvatar" Width="56" Height="56" CornerRadius="28"
                                Background="#6366F1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtAvatar" Text="?" FontSize="22" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="txtNomeContato" Text="Destino" FontSize="17" FontWeight="Bold"/>
                            <TextBlock x:Name="txtNumeroContato" Text="" FontSize="13"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Warning -->
                <Border Background="#FEF3C7" CornerRadius="10" Padding="13,10" Margin="0,14,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚠" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="#92400E"/>
                        <TextBlock Text="A chamada será transferida imediatamente. Você sairá da ligação automaticamente."
                                   FontSize="12" Foreground="#78350F" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Buttons -->
                <Grid Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancelar" Height="46"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancelar_Click" ToolTip="Cancelar — manter chamada atual"/>
                    <Button Grid.Column="2" Height="46" Click="BtnConfirmar_Click"
                            Cursor="Hand" ToolTip="Confirmar e executar transferência">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="12" Background="#6366F1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="12,0">
                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Confirmar transferência" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#4F46E5"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#4338CA"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>
    </Grid>
</Window>
