<UserControl x:Class="WavenVoIP.Views.ContactsTab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="txtNome" Grid.Column="0" Height="38" Margin="0,0,10,0" ToolTip="Nome"/>
            <TextBox x:Name="txtNumero" Grid.Column="1" Height="38" Margin="0,0,10,0" ToolTip="Número"/>
            <TextBox x:Name="txtObservacao" Grid.Column="2" Height="38" Margin="0,0,10,0" ToolTip="Observação"/>
            <Button Grid.Column="3" Content="Salvar contato" Height="38" Click="BtnSalvar_Click"/>
        </Grid>

        <DataGrid Grid.Row="1" x:Name="gridContatos" AutoGenerateColumns="False" RowHeight="42" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="Número" Binding="{Binding Numero}" Width="220"/>
                <DataGridTextColumn Header="Observação" Binding="{Binding Observacao}" Width="260"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="2"
                   Margin="0,10,0,0"
                   Text="Base pronta para salvar contatos localmente."
                   Foreground="#666"/>
    </Grid>
</UserControl>
