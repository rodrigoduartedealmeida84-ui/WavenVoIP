<Window x:Class="WavenVoIP.Views.SharedContactWarningDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aviso" SizeToContent="Height" Width="480" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="BtnAcao" TargetType="Button">
            <Setter Property="Height"          Value="42"/>
            <Setter Property="MinWidth"        Value="140"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnCancelar" TargetType="Button" BasedOn="{StaticResource BtnAcao}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" Padding="32,28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <StackPanel>

            <!-- Ícone + Título (Grid para evitar truncamento em horizontal StackPanel) -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtIcone" FontSize="28" Margin="0,0,12,0"
                           VerticalAlignment="Top" FontFamily="Segoe UI Emoji"/>
                <TextBlock Grid.Column="1" x:Name="txtTitulo" FontSize="17" FontWeight="Bold"
                           Foreground="#0F172A" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </Grid>

            <!-- Separador -->
            <Border Height="1" Background="#F1F5F9" Margin="0,0,0,18"/>

            <!-- Mensagem principal -->
            <TextBlock x:Name="txtMensagem" TextWrapping="Wrap" FontSize="13.5"
                       Foreground="#475569" LineHeight="22"/>

            <!-- Banner Google (fix: Grid para TextWrapping funcionar corretamente) -->
            <Border x:Name="bannerGoogle" Background="#EFF6FF" CornerRadius="8"
                    Padding="12,10" Margin="0,14,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x1F310;" FontFamily="Segoe UI Emoji" FontSize="15"
                               VerticalAlignment="Top" Margin="0,2,8,0"/>
                    <TextBlock Grid.Column="1" x:Name="txtMensagemGoogle"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="#1D4ED8"/>
                </Grid>
            </Border>

            <!-- Botões -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="btnCancelar" Content="Cancelar"
                        Style="{StaticResource BtnCancelar}"
                        Click="BtnCancelar_Click" Margin="0,0,10,0"/>
                <!-- Botão secundário — visível apenas no modo ExcluirGoogle -->
                <Button x:Name="btnAcaoSecundario" Visibility="Collapsed"
                        Style="{StaticResource BtnAcao}"
                        Click="BtnAcaoSecundario_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnAcao" Style="{StaticResource BtnAcao}"
                        Click="BtnAcao_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
