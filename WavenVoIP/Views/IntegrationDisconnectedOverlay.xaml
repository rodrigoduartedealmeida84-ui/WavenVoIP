<Window x:Class="WavenVoIP.Views.IntegrationDisconnectedOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="430" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="Transparent"
        AllowsTransparency="True">
    <Border Background="White" CornerRadius="16"
            BorderBrush="#E2E8F0" BorderThickness="1"
            Padding="30,26,30,26">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="24" ShadowDepth="6"/>
        </Border.Effect>
        <StackPanel>

            <!-- Icon + Title row -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Border Width="40" Height="40" CornerRadius="12"
                        Background="#FFF1F2" Margin="0,0,14,0">
                    <TextBlock Text="&#x26A0;" FontSize="20"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="#DC2626"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Integração desconectada"
                               FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock x:Name="txtNomeIntegracao" FontSize="12"
                               Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="txtMensagem"
                       FontSize="13" Foreground="#475569"
                       TextWrapping="Wrap" Margin="0,0,0,24"
                       LineHeight="20"/>

            <!-- Anti-loop warning (shown when loop is blocked) -->
            <Border x:Name="borderLoopWarning" Visibility="Collapsed"
                    Background="#FFF8F0" BorderBrush="#FED7AA" BorderThickness="1"
                    CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                <TextBlock Foreground="#92400E" FontSize="12" TextWrapping="Wrap"
                           Text="Reconexão já iniciada recentemente. Conclua o processo aberto ou aguarde 10 minutos antes de tentar novamente."/>
            </Border>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnAgoraNao" Content="Agora não"
                        Height="36" Padding="18,0" FontSize="13"
                        Background="White" Foreground="#64748B"
                        BorderBrush="#E2E8F0" BorderThickness="1.5"
                        Click="BtnAgoraNao_Click" Margin="0,0,10,0"/>
                <Button x:Name="btnReconectar" Content="Reconectar"
                        Height="36" Padding="20,0" FontSize="13" FontWeight="SemiBold"
                        Background="#7C3AED" Foreground="White" BorderThickness="0"
                        Click="BtnReconectar_Click"/>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
