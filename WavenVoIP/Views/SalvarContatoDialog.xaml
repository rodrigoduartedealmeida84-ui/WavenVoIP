<Window x:Class="WavenVoIP.Views.SalvarContatoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salvar contato" Height="560" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="22" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>
        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="txtDialogTitulo" Text="Salvar contato" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="txtDialogSubtitulo" Text="Adicione este número à sua lista de contatos." FontSize="13" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Banner Google (somente leitura) -->
            <Border x:Name="bannerGoogle" Grid.Row="1" CornerRadius="10" Background="#FFF8E1" BorderBrush="#F59E0B" BorderThickness="1" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="#B45309"/>
                    <StackPanel>
                        <TextBlock Text="Contato Google — somente leitura" FontWeight="SemiBold" FontSize="12" Foreground="#92400E"/>
                        <TextBlock Text="Clique em Salvar cópia local para criar uma versão editável." FontSize="11" Foreground="#92400E" Margin="0,1,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Nome -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Nome *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtNome" Style="{StaticResource FieldBox}" />
            </StackPanel>

            <!-- Número -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="Número *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtNumero" Style="{StaticResource FieldBox}"/>
            </StackPanel>

            <!-- Observação -->
            <StackPanel Grid.Row="4" Margin="0,0,0,6">
                <TextBlock Text="Empresa / Observação (opcional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtObservacao" Style="{StaticResource FieldBox}" />
            </StackPanel>

            <!-- Espaçador -->
            <Border Grid.Row="5"/>

            <!-- Botões -->
            <Grid Grid.Row="6" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource BtnSecondary}" Click="BtnCancelar_Click"/>
                <Button x:Name="btnSalvar" Grid.Column="2" Content="Salvar contato" Style="{StaticResource BtnPrimary}" Click="BtnSalvar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
