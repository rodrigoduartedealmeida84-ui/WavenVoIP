<Window x:Class="WavenVoIP.Views.SalvarContatoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Salvar contato" Height="620" Width="560" MinWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#7C3AED"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.88"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="22" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.2"/>
        </Border.Effect>
        <Grid Margin="28,22,28,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock x:Name="txtDialogTitulo" Text="Salvar contato" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock x:Name="txtDialogSubtitulo" Text="Adicione este número à sua lista de contatos." FontSize="13" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Banner Google (contato empresa) -->
            <Border x:Name="bannerGoogle" Grid.Row="1" CornerRadius="10" Background="#F0FDF4" BorderBrush="#22C55E" BorderThickness="1" Padding="12,10" Margin="0,0,0,12" Visibility="Collapsed">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🏢" FontFamily="Segoe UI Emoji" FontSize="15"
                               VerticalAlignment="Top" Margin="0,2,10,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Será salvo como contato compartilhado da empresa"
                                   FontWeight="SemiBold" FontSize="12" Foreground="#15803D"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Visível para todos os ramais via Waven API. O contato Google original não é alterado."
                                   FontSize="11" Foreground="#166534" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nome -->
            <StackPanel Grid.Row="2" Margin="0,0,0,14">
                <TextBlock Text="Nome *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtNome" Style="{StaticResource FieldBox}" />
            </StackPanel>

            <!-- Número -->
            <StackPanel Grid.Row="3" Margin="0,0,0,14">
                <TextBlock Text="Número *" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtNumero" Style="{StaticResource FieldBox}"/>
            </StackPanel>

            <!-- Observação -->
            <StackPanel Grid.Row="4" Margin="0,0,0,6">
                <TextBlock Text="Empresa / Observação (opcional)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="txtObservacao" Style="{StaticResource FieldBox}" />
            </StackPanel>

            <!-- Adicionar aos favoritos -->
            <Border Grid.Row="5" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,6,0,0">
                <CheckBox x:Name="chkFavoritos" Cursor="Hand">
                    <CheckBox.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⭐" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Adicionar aos favoritos" FontSize="13" FontWeight="SemiBold" Foreground="#4C1D95" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox.Content>
                </CheckBox>
            </Border>

            <!-- Espaçador -->
            <Border Grid.Row="6"/>

            <!-- Botões -->
            <Grid Grid.Row="7" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancelar" Style="{StaticResource BtnSecondary}" Click="BtnCancelar_Click"/>
                <Button x:Name="btnSalvar" Grid.Column="2" Content="Salvar contato" Style="{StaticResource BtnPrimary}" Click="BtnSalvar_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
