<Window x:Class="WavenVoIP.Views.ConferenceControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conferência" Height="560" Width="800" MinHeight="460" MinWidth="700"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Icon="/Assets/wavenvoip.ico"
        Background="#F7F6FB" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="CaretBrush" Value="#111827"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Botão só com ícone (Content = glifo Segoe MDL2) -->
        <Style x:Key="IconeBtn" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#F5F3FF"/>
            <Setter Property="Foreground" Value="#6D28D9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}">
                            <TextBlock Text="{TemplateBinding Content}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.6"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão com ícone + texto (Tag = glifo, Content = texto) -->
        <Style x:Key="AcaoBtn" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#F5F3FF"/>
            <Setter Property="Foreground" Value="#5B21B6"/>
            <Setter Property="BorderBrush" Value="#DDD6FE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="11" Background="{TemplateBinding Background}" Padding="13,0"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bg" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#ECE9F6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Grid Margin="2,0,2,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="40" Height="40" CornerRadius="13" Background="#7C3AED" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Conferência" FontSize="18" FontWeight="Bold" Foreground="#1E1B4B"/>
                <TextBlock x:Name="txtStatus" Text="Clique em um ramal e em Adicionar." Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
            <Border Grid.Column="2" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Sala " Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBlock x:Name="txtSalaVisual" Text="800" FontWeight="Bold" FontSize="12.5" Foreground="#5B21B6"/>
                    <TextBox x:Name="txtSala" Text="800" Width="1" Height="1" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="292"/>
            </Grid.ColumnDefinitions>

            <!-- Esquerda: ramais online + adicionar -->
            <Border Style="{StaticResource Cartao}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="2,0,0,8">
                        <Button x:Name="btnBuscarContato" DockPanel.Dock="Right" Style="{StaticResource AcaoBtn}" Height="32" FontSize="12" Tag="&#xE721;" Content="Buscar Contato"
                                Click="BtnBuscarContato_Click" ToolTip="Procurar um contato externo para adicionar"/>
                        <TextBlock Text="Ramais online" FontSize="14" FontWeight="Bold" Foreground="#1E1B4B" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtAoVivo" Text="" FontSize="11.5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="10,1,8,0" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="-4,0">
                            <ItemsControl x:Name="listaRamais">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="card" Margin="4" Padding="10,8" CornerRadius="12" Background="#FAF9FF" BorderBrush="#EEEAFB" BorderThickness="1.5"
                                                Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="Ramal_MouseLeftButtonDown" ToolTip="Um clique seleciona; dois cliques adicionam">
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Background="{Binding CorFundo}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Ramal}" FontSize="12" FontWeight="Bold" Foreground="{Binding Cor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="#1E1B4B" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <Ellipse Width="7" Height="7" Fill="{Binding Cor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{Binding StatusTexto}" FontSize="11.5" Foreground="{Binding Cor}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="#C4B5FD"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Selecionado}" Value="True">
                                                <Setter TargetName="card" Property="BorderBrush" Value="#7C3AED"/>
                                                <Setter TargetName="card" Property="Background" Value="#EDE9FE"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="txtSemRamais" Text="Nenhum outro ramal online no momento." Visibility="Collapsed" Foreground="{StaticResource MutedBrush}"
                                   FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"/>
                    </Grid>

                    <!-- Busca de contato externo (abre só quando pedido) -->
                    <Border x:Name="painelContatos" Grid.Row="2" Visibility="Collapsed" Background="#FAF9FF" BorderBrush="#EEEAFB" BorderThickness="1" CornerRadius="12" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBox x:Name="txtBuscaContato" Height="36" FontSize="13" Padding="32,0,10,0" TextChanged="TxtBuscaContato_TextChanged"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center" Margin="11,0,0,0"/>
                                <TextBlock x:Name="txtDicaBusca" Text="Nome ou número do contato" IsHitTestVisible="False" Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center" Margin="33,0,0,0"/>
                            </Grid>
                            <ListBox x:Name="lstContatos" Height="132" Margin="0,6,0,0" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                                     SelectionChanged="LstContatos_SelectionChanged" MouseDoubleClick="LstContatos_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Numero}" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                            <TextBlock Text="{Binding Nome}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E1B4B" TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Destino + ações -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="txtDestino" Height="40" TextChanged="TxtDestino_TextChanged" KeyDown="TxtDestino_KeyDown"/>
                            <TextBlock x:Name="txtDicaDestino" Text="Ramal ou número" IsHitTestVisible="False" Foreground="#94A3B8" FontSize="13.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <Button x:Name="btnAdicionar" Grid.Column="2" Style="{StaticResource AcaoBtn}" Tag="&#xE710;" Content="Adicionar" Margin="8,0,0,0"
                                Background="#16A34A" BorderBrush="#16A34A" Foreground="White" Click="BtnAdicionar_Click"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Direita: participantes + microfone -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Cartao}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Margin="2,0,0,6">
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconeBtn}" Width="30" Height="30" Content="&#xE72C;" Click="BtnAtualizar_Click" ToolTip="Atualizar agora"/>
                            <TextBlock Text="Participantes" FontSize="14" FontWeight="Bold" Foreground="#1E1B4B" VerticalAlignment="Center"/>
                            <Border Background="#F5F3FF" CornerRadius="9" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <TextBlock x:Name="txtQtdParticipantes" Text="0" FontSize="11.5" FontWeight="Bold" Foreground="#6D28D9"/>
                            </Border>
                        </DockPanel>
                        <ListBox Grid.Row="1" x:Name="lstParticipantes" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,7" Margin="0,3" Background="#FAF9FF" CornerRadius="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding BrushStatus}" VerticalAlignment="Center" Margin="2,0,9,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Exibicao}" FontWeight="SemiBold" FontSize="12.5" Foreground="#1E1B4B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Exibicao}"/>
                                                <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconeBtn}" Width="30" Height="30" Content="&#xE74F;" Margin="0,0,5,0" Tag="{Binding Numero}"
                                                        Click="BtnMutarSelecionado_Click" ToolTip="Silenciar participante"/>
                                                <Button Style="{StaticResource IconeBtn}" Width="30" Height="30" Content="&#xE711;" Background="#FEE2E2" Foreground="#DC2626" Tag="{Binding Numero}"
                                                        Click="BtnRemoverSelecionado_Click" ToolTip="Remover da conferência"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="txtSemParticipantes" Grid.Row="1" Text="Ninguém foi adicionado ainda." Foreground="{StaticResource MutedBrush}" FontSize="12.5"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Cartao}" Padding="12,10" Margin="0,10,0,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource AcaoBtn}" Height="36" Tag="&#xE711;" Content="Fechar" Background="White" Foreground="#475569" BorderBrush="#E2E8F0"
                                Click="BtnFechar_Click" ToolTip="Fechar esta janela (a conferência continua)"/>
                        <Button x:Name="btnMuteHost" DockPanel.Dock="Left" Style="{StaticResource IconeBtn}" Width="36" Height="36" Content="&#xE720;" Background="#7C3AED" Foreground="White"
                                Click="BtnMuteHost_Click" ToolTip="Ligar/desligar meu microfone"/>
                        <StackPanel VerticalAlignment="Center" Margin="10,0,8,0">
                            <TextBlock Text="Meu microfone" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E1B4B"/>
                            <TextBlock x:Name="txtHostStatus" Text="Ativo" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
