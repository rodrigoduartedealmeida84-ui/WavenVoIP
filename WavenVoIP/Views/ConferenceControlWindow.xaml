<Window x:Class="WavenVoIP.Views.ConferenceControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conferência" Height="620" Width="880" MinHeight="520" MinWidth="720"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Icon="/Assets/wavenvoip.ico">
    <Window.Resources>
        <!-- TextBox seguro: garante texto visível independente do tema global -->
        <Style TargetType="TextBox">
            <Setter Property="Foreground"              Value="#111827"/>
            <Setter Property="CaretBrush"              Value="#111827"/>
            <Setter Property="Background"              Value="#FFFFFF"/>
            <Setter Property="BorderBrush"             Value="#D1D5DB"/>
            <Setter Property="BorderThickness"         Value="1.5"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="FontSize"                Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"              Value="False"/>
            <Setter Property="IsEnabled"               Value="True"/>
            <Setter Property="Focusable"               Value="True"/>
            <Setter Property="IsHitTestVisible"        Value="True"/>
        </Style>

        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="12" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Border Style="{StaticResource CardStyle}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <DockPanel Margin="0,0,0,10">
                    <Border DockPanel.Dock="Left" Width="190" Height="64" ClipToBounds="True" Margin="0,0,16,0">
                        <Image Source="/Assets/Brand/waven_logo_dark.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Controle de conferência" FontSize="18" FontWeight="Bold"/>
                        <TextBlock x:Name="txtStatus" Text="Adicione participantes e acompanhe o status." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="#F8FAFC" BorderBrush="#E7EAF3" BorderThickness="1" CornerRadius="10" Padding="10,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Sala " Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            <TextBlock x:Name="txtSalaVisual" Text="800" FontWeight="Bold" FontSize="13"/>
                            <TextBox x:Name="txtSala" Text="800" Width="1" Height="1" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </DockPanel>

                <!-- Add participant bar -->
                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="14" BorderBrush="#E7EAF3" BorderThickness="1" Padding="12,8" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Ramal ou número externo" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="txtDestino" Height="44" FontSize="15" VerticalContentAlignment="Center"
                                     Foreground="#111827" CaretBrush="#111827" Background="#FFFFFF"
                                     BorderBrush="#D1D5DB" BorderThickness="1.5" Padding="10,0"
                                     IsReadOnly="False" IsEnabled="True" Focusable="True" IsHitTestVisible="True"/>
                        </StackPanel>
                        <Button x:Name="btnAdicionar" Grid.Column="1" Content="Adicionar" Height="36" VerticalAlignment="Bottom"
                                Background="#22C55E" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                BorderThickness="0" Click="BtnAdicionar_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#22C55E"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="13"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}" Padding="10,0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#16A34A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#15803D"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bg" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>
                </Border>

                <!-- Main content: Contacts | (Host controls + Participants) -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="265"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Contacts panel -->
                    <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E7EAF3" BorderThickness="1" Padding="10" Margin="0,0,10,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Contatos" FontSize="15" FontWeight="Bold"/>
                            <TextBox Grid.Row="1" x:Name="txtBuscaContato" Height="38" Margin="0,6,0,6"
                                     VerticalContentAlignment="Center" TextChanged="TxtBuscaContato_TextChanged"
                                     FontSize="13" Foreground="#111827" CaretBrush="#111827" Background="#FFFFFF"
                                     BorderBrush="#D1D5DB" BorderThickness="1.5" Padding="8,0"
                                     IsReadOnly="False" IsEnabled="True" Focusable="True" IsHitTestVisible="True"/>
                            <ListBox Grid.Row="2" x:Name="lstContatos" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="LstContatos_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,2" Background="#F8FAFC" CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Numero}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="Usar" Height="28" Tag="{Binding Numero}" Click="SelecionarContato_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="4,2" FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right: Host controls + Participants -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Host controls with SVG icon buttons -->
                        <Border Grid.Row="0" Background="#F0F4FF" CornerRadius="14" BorderBrush="#C7D2FE" BorderThickness="1" Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="Meu controle (host)" FontSize="14" FontWeight="Bold" Foreground="#3730A3"/>
                                    <TextBlock x:Name="txtHostStatus" Text="Microfone ativo" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0">
                                    <!-- Mute mic button — square rounded, consistent with participant buttons -->
                                    <Button x:Name="btnMuteHost" Width="40" Height="40" Margin="0,0,8,0"
                                            Click="BtnMuteHost_Click" ToolTip="Mutar/Desmutar microfone"
                                            BorderThickness="0" Cursor="Hand" Background="#6366F1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}">
                                                    <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path x:Name="pathMuteHostIcon" Fill="White"
                                                                  Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Opacity" Value="0.82"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bg" Property="Opacity" Value="0.65"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- Leave conference button -->
                                    <Button Width="40" Height="40" Click="BtnSairConferencia_Click"
                                            ToolTip="Sair da conferência" BorderThickness="0" Cursor="Hand" Background="#EF4444">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}">
                                                    <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Fill="White" Data="M10.09,15.59L11.5,17L16.5,12L11.5,7L10.09,8.41L12.67,11H3V13H12.67L10.09,15.59M19,3H5C3.89,3 3,3.9 3,5V9H5V5H19V19H5V15H3V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Opacity" Value="0.82"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bg" Property="Opacity" Value="0.65"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Participants list -->
                        <Border Grid.Row="1" Background="White" CornerRadius="14" BorderBrush="#E7EAF3" BorderThickness="1" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock Text="Participantes" FontSize="15" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <Button Width="34" Height="34" DockPanel.Dock="Right" Click="BtnAtualizar_Click"
                                            ToolTip="Atualizar participantes" BorderThickness="0" Cursor="Hand" Background="#6366F1">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" CornerRadius="10" Background="{TemplateBinding Background}">
                                                    <Viewbox Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Fill="White" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.82"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.65"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DockPanel>
                                <ListBox Grid.Row="1" x:Name="lstParticipantes" Margin="0,8,0,0" BorderBrush="#E5E7EB" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10,8" Margin="0,3" Background="#F8FAFC" CornerRadius="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="40"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="14"/>
                                                        <ColumnDefinition Width="88"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Avatar circle -->
                                                    <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                            Background="{Binding BrushAvatar}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Iniciais}" FontSize="13" FontWeight="Bold"
                                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Name + status text -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,8,0">
                                                        <TextBlock Text="{Binding Numero}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                    <!-- Status dot -->
                                                    <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center"
                                                             Fill="{Binding BrushStatus}"/>
                                                    <!-- Action buttons -->
                                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <Button Width="38" Height="38" Margin="0,0,6,0" Tag="{Binding Numero}"
                                                                Click="BtnMutarSelecionado_Click" ToolTip="Mutar participante"
                                                                BorderThickness="0" Cursor="Hand" Background="#6366F1">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bg" CornerRadius="9" Background="{TemplateBinding Background}">
                                                                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Canvas Width="24" Height="24">
                                                                                <Path Fill="White" Data="M12,2A3,3 0 0,1 15,5V11A3,3 0 0,1 12,14A3,3 0 0,1 9,11V5A3,3 0 0,1 12,2M19,11C19,14.53 16.39,17.44 13,17.93V21H11V17.93C7.61,17.44 5,14.53 5,11H7A5,5 0 0,0 12,16A5,5 0 0,0 17,11H19Z"/>
                                                                            </Canvas>
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.8"/></Trigger>
                                                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.6"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                        <Button Width="38" Height="38" Tag="{Binding Numero}"
                                                                Click="BtnRemoverSelecionado_Click" ToolTip="Remover participante"
                                                                BorderThickness="0" Cursor="Hand" Background="#EF4444">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="bg" CornerRadius="9" Background="{TemplateBinding Background}">
                                                                        <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                            <Canvas Width="24" Height="24">
                                                                                <Path Fill="White" Data="M20,5.27L18.73,4L12,10.73L5.27,4L4,5.27L10.73,12L4,18.73L5.27,20L12,13.27L18.73,20L20,18.73L13.27,12L20,5.27Z"/>
                                                                            </Canvas>
                                                                        </Viewbox>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.8"/></Trigger>
                                                                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="bg" Property="Opacity" Value="0.6"/></Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Footer -->
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <Button Content="Fechar" Width="110" Height="36" DockPanel.Dock="Right" Style="{StaticResource SecondaryButtonStyle}" Click="BtnFechar_Click" FontSize="12"/>
                    <TextBlock Text="Participantes são chamados diretamente para a sala. O host é unido automaticamente." Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
