<Window x:Class="WavenVoIP.Views.MissedCallToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamada perdida"
        Height="110" Width="370"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="toastRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25"/>
                    <ThicknessAnimation Storyboard.TargetName="toastRoot"
                                        Storyboard.TargetProperty="Margin"
                                        From="0,20,0,-20" To="0,0,0,0"
                                        Duration="0:0:0.25">
                        <ThicknessAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="toastRoot" Margin="10,6,10,10"
            Background="White" CornerRadius="18"
            BorderBrush="#DDD6FE" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>

            <!-- Missed call icon -->
            <Border Width="38" Height="38" CornerRadius="19" Background="#FEE2E2" VerticalAlignment="Center">
                <TextBlock Text="↘" Foreground="#DC2626" FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Text -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="2,0,4,0">
                <TextBlock Text="Chamada perdida" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="txtCaller" Margin="0,2,0,0" FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Close -->
            <Button Grid.Column="2" Content="×" Width="26" Height="26"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{StaticResource MutedBrush}"
                    FontSize="18" FontWeight="Bold"
                    VerticalAlignment="Top" HorizontalAlignment="Right"
                    Cursor="Hand" Click="Close_Click"
                    ToolTip="Fechar"/>
        </Grid>
    </Border>
</Window>
