<Window x:Class="WavenVoIP.Views.InputPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Informar destino" Height="680" Width="980" MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Icon="/Assets/wavenvoip.ico">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Foreground"              Value="#111827"/>
            <Setter Property="CaretBrush"              Value="#111827"/>
            <Setter Property="Background"              Value="#FFFFFF"/>
            <Setter Property="BorderBrush"             Value="#D1D5DB"/>
            <Setter Property="BorderThickness"         Value="1.5"/>
            <Setter Property="Padding"                 Value="10,0"/>
            <Setter Property="FontSize"                Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly"              Value="False"/>
            <Setter Property="IsEnabled"               Value="True"/>
            <Setter Property="Focusable"               Value="True"/>
            <Setter Property="IsHitTestVisible"        Value="True"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Border Style="{StaticResource CardStyle}" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12">
                    <Image Source="/Assets/Brand/waven_logo_dark.png" Height="68" Stretch="Uniform" DockPanel.Dock="Left" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="Waven VoIP" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="14"/><TextBlock x:Name="txtTitulo" Text="Digite o destino" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" MaxWidth="820"/></StackPanel>
                </DockPanel>
                <TextBox Grid.Row="1" x:Name="txtValor" Height="52" FontSize="22" FontWeight="SemiBold"
                         TextAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,0,8"
                         Foreground="#111827" CaretBrush="#111827" Background="#FFFFFF"
                         BorderBrush="#D1D5DB" BorderThickness="1.5" Padding="12,0"
                         IsReadOnly="False" IsEnabled="True" Focusable="True" IsHitTestVisible="True"/>
                <TextBlock Grid.Row="2" Margin="0,0,0,12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="13" Text="Digite o ramal/número ou selecione um contato salvo."/>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <UniformGrid Rows="4" Columns="3" Margin="0,0,14,0">
                        <Button Content="1" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="2" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="3" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="4" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="5" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="6" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="7" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="8" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="9" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button Content="*" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="0" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="#" Click="Tecla_Click" FontSize="21" Margin="4" Style="{StaticResource SecondaryButtonStyle}"/>
                    </UniformGrid>
                    <Border Grid.Column="1" Background="#F8FAFC" CornerRadius="18" Padding="16" BorderBrush="#E7EAF3" BorderThickness="1">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Contatos salvos" FontWeight="Bold" FontSize="17"/>
                            <TextBox Grid.Row="1" x:Name="txtBuscaContato" Height="42" Margin="0,8,0,8"
                                     ToolTip="Buscar contato" TextChanged="TxtBuscaContato_TextChanged"
                                     Foreground="#111827" CaretBrush="#111827" Background="#FFFFFF"
                                     BorderBrush="#D1D5DB" BorderThickness="1.5" Padding="10,0"
                                     VerticalContentAlignment="Center" FontSize="15"
                                     IsReadOnly="False" IsEnabled="True" Focusable="True" IsHitTestVisible="True"/>
                            <ListBox Grid.Row="2" x:Name="lstContatos" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="LstContatos_MouseDoubleClick">
                                <ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,5" Background="White" CornerRadius="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="135"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="{Binding Nome}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Numero}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="Selecionar" Height="36" MinWidth="116" Margin="12,0,0,0" Tag="{Binding Numero}" Click="UsarContato_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="4,2"/></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
                <Grid Grid.Row="4" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Button Content="Apagar" Width="118" Height="42" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}" Click="BtnApagar_Click"/>
                    <Button Grid.Column="1" Content="Cancelar" Width="124" Height="42" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancelar_Click"/>
                    <Button Grid.Column="2" Content="Confirmar" Width="132" Height="42" Style="{StaticResource PrimaryButtonStyle}" Click="BtnConfirmar_Click"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
