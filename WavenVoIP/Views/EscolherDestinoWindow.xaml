<Window x:Class="WavenVoIP.Views.EscolherDestinoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Escolher destino" Width="640" Height="560" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F5F3FF" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="BotaoPrimario" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="11" Padding="20,9">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#6D28D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.38"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotaoSecundario" TargetType="Button">
            <Setter Property="Foreground" Value="#5B21B6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="White" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="11" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#EDE9FE"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaixaTexto" TargetType="TextBox">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="CaretBrush" Value="#111827"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="White" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="11" Padding="10,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="#8B5CF6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="22,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#7C3AED" Offset="0"/>
                    <GradientStop Color="#5B21B6" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="#33FFFFFF" Margin="0,0,13,0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtIcone" Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="txtTitulo" Text="Escolher destino" FontSize="18" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="txtSubtitulo" Text="Escolha um ramal e confirme" FontSize="12" Foreground="#E9D5FF" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="18,14,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="2,0,2,8">
                <TextBlock x:Name="txtAoVivo" DockPanel.Dock="Right" Text="" FontSize="11" Foreground="#7C7A9C" VerticalAlignment="Center"/>
                <TextBlock Text="RAMAIS ONLINE" FontSize="10.5" FontWeight="SemiBold" Foreground="#7C7A9C" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Grid.Row="1" Background="White" CornerRadius="14" BorderBrush="#E9E5FB" BorderThickness="1">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                        <ItemsControl x:Name="listaRamais">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="card" Width="170" Margin="5" Padding="10,9" CornerRadius="12" Background="#FAF9FF" BorderBrush="#EEEAFB" BorderThickness="1.5"
                                            Cursor="Hand" Tag="{Binding}" MouseLeftButtonDown="Ramal_MouseLeftButtonDown">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="20" Background="{Binding CorFundo}" Margin="0,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Ramal}" FontSize="13" FontWeight="Bold" Foreground="{Binding Cor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Nome}" FontSize="13" FontWeight="SemiBold" Foreground="#1E1B4B" TextTrimming="CharacterEllipsis" ToolTip="{Binding Nome}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding Cor}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding StatusTexto}" FontSize="11.5" Foreground="{Binding Cor}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="#C4B5FD"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding Selecionado}" Value="True">
                                            <Setter TargetName="card" Property="BorderBrush" Value="#7C3AED"/>
                                            <Setter TargetName="card" Property="Background" Value="#EDE9FE"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="txtSemRamais" Text="Nenhum ramal online no momento." Foreground="#9CA3AF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" TextWrapping="Wrap" Margin="16"/>
                </Grid>
            </Border>

            <!-- Outro número / Buscar contato -->
            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <TextBox x:Name="txtNumero" Height="40" Style="{StaticResource CaixaTexto}" TextChanged="TxtNumero_TextChanged"/>
                    <TextBlock x:Name="txtDicaNumero" Text="Outro ramal ou número…" Foreground="#9CA3AF" FontSize="13" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Button Grid.Column="1" x:Name="btnBuscarContato" Style="{StaticResource BotaoSecundario}" Click="BtnBuscarContato_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Buscar Contato" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="3" x:Name="painelContatos" Visibility="Collapsed" Margin="0,10,0,0" Background="White" CornerRadius="14" BorderBrush="#E9E5FB" BorderThickness="1" Padding="10">
                <StackPanel>
                    <Grid>
                        <TextBox x:Name="txtBuscaContato" Height="36" Style="{StaticResource CaixaTexto}" TextChanged="TxtBuscaContato_TextChanged"/>
                        <TextBlock x:Name="txtDicaBusca" Text="Digite o nome ou o número do contato…" Foreground="#9CA3AF" FontSize="12.5" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                    <ListBox x:Name="lstContatos" Height="132" Margin="0,8,0,0" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="LstContatos_SelectionChanged" MouseDoubleClick="LstContatos_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="2,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Numero}" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    <TextBlock Text="{Binding Nome}" FontSize="13" Foreground="#1E1B4B" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="20,14,20,16" LastChildFill="True">
            <Button DockPanel.Dock="Right" x:Name="btnConfirmar" Content="Confirmar" Style="{StaticResource BotaoPrimario}" IsEnabled="False" IsDefault="True" Click="BtnConfirmar_Click"/>
            <Button DockPanel.Dock="Right" Content="Cancelar" Style="{StaticResource BotaoSecundario}" IsCancel="True" Margin="0,0,10,0" Click="BtnCancelar_Click"/>
            <TextBlock x:Name="txtSelecionado" Text="Nenhum destino escolhido" FontSize="12.5" FontWeight="SemiBold" Foreground="#4C1D95" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
