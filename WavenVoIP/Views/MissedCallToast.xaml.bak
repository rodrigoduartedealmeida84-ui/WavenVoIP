<Window x:Class="WavenVoIP.Views.MissedCallToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamada perdida" Height="150" Width="360"
        WindowStartupLocation="Manual" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Margin="10" Background="White" CornerRadius="22" BorderBrush="#E7EAF3" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="26" ShadowDepth="7" Opacity="0.25"/></Border.Effect>
        <Grid Margin="18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="24" Background="#FEE2E2" VerticalAlignment="Top"><TextBlock Text="↘" Foreground="#DC2626" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Chamada perdida" FontSize="18" FontWeight="Bold" Foreground="#101828"/>
                <TextBlock x:Name="txtCaller" Margin="0,5,0,0" FontSize="14" Foreground="#334155" TextWrapping="Wrap"/>
                <TextBlock Text="Registrada no histórico." Margin="0,5,0,0" FontSize="12" Foreground="#667085"/>
            </StackPanel>
            <Button Grid.Column="2" Content="×" Width="28" Height="28" Background="Transparent" BorderThickness="0" Foreground="#667085" FontSize="20" Click="Close_Click"/>
        </Grid>
    </Border>
</Window>
