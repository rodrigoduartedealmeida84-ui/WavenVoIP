<Window x:Class="WavenVoIP.Views.TransferControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transferência assistida" Height="490" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="/Assets/wavenvoip.ico">
    <Grid Margin="16">
        <Border Style="{StaticResource CardStyle}" Padding="22,24,22,22">
            <StackPanel>

                <!-- ── Destino header ── -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="borderAvatar" Width="58" Height="58" CornerRadius="29"
                            Background="#6366F1" Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock x:Name="txtAvatar" Text="?" FontSize="24" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="txtNomeDestino" Text="Destino" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="txtNumeroDestino" Text="" FontSize="13"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ── Status bar: dot + text + timer ── -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="14" Height="14" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse x:Name="dotStatusPulse" Width="14" Height="14"
                                 Fill="#F59E0B" Opacity="0"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse x:Name="dotStatusCore" Width="9" Height="9"
                                 Fill="#F59E0B"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Column="1" x:Name="txtStatusTransferencia"
                               Text="Chamando..." FontSize="13"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="txtTempoTransferencia"
                               Text="0:00" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- ── Two-call cards ── -->
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <!-- Chamada original (em espera) -->
                    <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="12" Padding="12,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="⏸" FontSize="13" Margin="0,0,6,0"
                                           Foreground="#6B7280" VerticalAlignment="Center"/>
                                <TextBlock Text="Chamada original" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#374151" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtChamadaOriginal" Text="Em espera"
                                       FontSize="12" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                    <!-- Arrow -->
                    <TextBlock Grid.Column="1" Text="→" FontSize="16" Foreground="#9CA3AF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- Destino (chamada de transferência) -->
                    <Border Grid.Column="2" Background="#EEF2FF" CornerRadius="12" Padding="12,10"
                            BorderBrush="#C7D2FE" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <Ellipse Width="8" Height="8" Fill="#6366F1"
                                         Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Destino" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#3730A3" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="txtDestinoCard" Text=""
                                       FontSize="12" Foreground="#4338CA" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ── Info text ── -->
                <Border Background="#FEF9C3" CornerRadius="10" Padding="12,9" Margin="0,14,0,0">
                    <TextBlock Text="Se o destino não atender ou estiver ocupado, clique em Voltar para mim para retornar à chamada original."
                               FontSize="12" Foreground="#713F12" TextWrapping="Wrap"/>
                </Border>

                <!-- ── Action buttons ── -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Voltar para mim (vermelho) -->
                    <Button Grid.Row="0" Grid.Column="0" Height="48" Margin="0,0,6,0"
                            Click="BtnVoltar_Click" Cursor="Hand" ToolTip="Retornar à chamada original">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="12" Background="#EF4444">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Voltar para mim" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#DC2626"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#B91C1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Concluir transferência (verde) -->
                    <Button Grid.Row="0" Grid.Column="1" Height="48" Margin="6,0,0,0"
                            Click="BtnConcluir_Click" Cursor="Hand" ToolTip="Concluir a transferência">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="12" Background="#22C55E">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,0">
                                        <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Concluir transferência" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#16A34A"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#15803D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Enviar * (cinza) -->
                    <Button Grid.Row="2" Grid.Column="0" Height="40" Margin="0,0,6,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnEstrela_Click" ToolTip="Enviar tecla * via DTMF">
                        <TextBlock Text="Enviar  ✱" FontSize="12" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Fechar (cinza) -->
                    <Button Grid.Row="2" Grid.Column="1" Height="40" Margin="6,0,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnFechar_Click" ToolTip="Fechar este painel (não desliga)">
                        <TextBlock Text="Fechar" FontSize="12" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>

                <!-- compat: txtDestino oculto -->
                <TextBlock x:Name="txtDestino" Visibility="Collapsed"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
