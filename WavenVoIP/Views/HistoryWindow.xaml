<Window x:Class="WavenVoIP.Views.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Histórico" Height="760" Width="1220" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterOwner" Icon="/Assets/wavenvoip.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White" BorderBrush="#E7EAF3" BorderThickness="0,0,1,0" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Border Width="200" Height="68" ClipToBounds="True" HorizontalAlignment="Left">
                        <Image Source="/Assets/Brand/waven_logo_dark.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    </Border>
                    <TextBlock Text="Waven VoIP" FontSize="22" FontWeight="Bold" Margin="0,16,0,2"/>
                    <TextBlock Text="Comunicações" Foreground="{StaticResource MutedBrush}" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Button Content="＋ Nova chamada" Style="{StaticResource PrimaryButtonStyle}" Height="48"/>
                    <Button Content="⌕ Discagem" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="↙ Chamadas recebidas" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="☎ Contatos" Style="{StaticResource NavButtonStyle}"/>
                    <Button Content="↺ Histórico" Style="{StaticResource NavButtonStyle}" Background="{StaticResource PrimarySoftBrush}" Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Regra de rota" FontWeight="SemiBold"/>
                    <TextBlock Text="1 Operadora · 2 WhatsApp TIM · 3 WhatsApp Vivo" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,24">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Histórico de chamadas" FontSize="32" FontWeight="Bold"/>
                    <TextBlock Text="Acompanhe chamadas realizadas, recebidas e perdidas." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" Background="White" CornerRadius="18" Padding="12,0" BorderBrush="#E7EAF3" BorderThickness="1" Width="370" Height="48">
                    <DockPanel>
                        <TextBlock Text="🔎" VerticalAlignment="Center" FontSize="16" Margin="0,0,8,0"/>
                        <TextBox x:Name="txtBusca" BorderThickness="0" Background="Transparent" Height="42" Margin="0" TextChanged="TxtBusca_TextChanged" ToolTip="Pesquisar no histórico"/>
                    </DockPanel>
                </Border>
            </DockPanel>

            <Grid Grid.Row="1" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="23" Background="{StaticResource PrimarySoftBrush}" Margin="0,0,14,0"><TextBlock Text="☎" Foreground="{StaticResource PrimaryBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel><TextBlock Text="TOTAL DE CHAMADAS" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Histórico local" FontSize="20" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18" Margin="6,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="23" Background="#ECFDF3" Margin="0,0,14,0"><TextBlock Text="↗" Foreground="#16A34A" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel><TextBlock Text="SAÍDAS" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Operadora / WhatsApp" FontSize="20" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="46" Height="46" CornerRadius="23" Background="#FEF2F2" Margin="0,0,14,0"><TextBlock Text="↙" Foreground="#DC2626" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel><TextBlock Text="ORIGEM" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Detectada do Issabel" FontSize="20" FontWeight="Bold"/></StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <ListView x:Name="gridHistorico" BorderThickness="0" Background="Transparent" MouseDoubleClick="GridHistorico_MouseDoubleClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="2.1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="95"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="13" Background="#F1F5F9" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icone}" Foreground="{Binding CorTipo}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding NomeExibido}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding NumeroLimpoVisual}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TipoTexto}" Foreground="{Binding CorTipo}" FontWeight="Bold" FontSize="14"/>
                                        <TextBlock Text="{Binding OrigemSaidaVisual}" Foreground="{StaticResource PrimaryBrush}" FontSize="13" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DataHoraRelativa}" FontSize="14" ToolTip="{Binding DataHoraFormatada}"/>
                                        <TextBlock Text="Data e hora" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Duracao}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Duração" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Ligar" Click="BtnLigarHistorico_Click" Tag="{Binding Numero}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Width="78" Padding="10,4"/>
                                        <Button Content="WhatsApp" Click="BtnWhatsAppHistorico_Click" Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Height="40" Width="100" Padding="10,4" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <TextBlock Grid.Row="3" Margin="0,14,0,0" Text="Ao ligar pelo histórico, o prefixo de rota salvo é removido antes de escolher uma nova saída." Foreground="{StaticResource MutedBrush}" FontSize="13"/>
        </Grid>
    </Grid>
</Window>
