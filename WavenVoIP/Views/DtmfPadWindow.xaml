<Window x:Class="WavenVoIP.Views.DtmfPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teclado DTMF"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/wavenvoip.ico"
        Background="#F7FAFC">
    <Window.Resources>
        <!-- ── DtmfKeyStyle ──────────────────────────────────────────── -->
        <Style x:Key="DtmfKeyStyle" TargetType="Button">
            <Setter Property="Background"      Value="#F3F4F6"/>
            <Setter Property="Foreground"      Value="#1F2433"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin"          Value="4"/>
            <Setter Property="MinWidth"        Value="68"/>
            <Setter Property="MinHeight"       Value="56"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="UseLayoutRounding" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13"
                                Padding="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E8EBF2"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#C7D2E0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── DtmfKeyNumberStyle / DtmfKeyLettersStyle ─────────────────── -->
        <Style x:Key="DtmfKeyNumberStyle" TargetType="TextBlock">
            <Setter Property="FontSize"           Value="19"/>
            <Setter Property="FontWeight"         Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment"      Value="Center"/>
        </Style>
        <Style x:Key="DtmfKeyLettersStyle" TargetType="TextBlock">
            <Setter Property="FontSize"           Value="9.5"/>
            <Setter Property="FontWeight"         Value="SemiBold"/>
            <Setter Property="Foreground"         Value="{StaticResource MutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment"      Value="Center"/>
            <Setter Property="MinHeight"          Value="14"/>
            <Setter Property="Margin"             Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12" SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Border Background="White" CornerRadius="18" Padding="14" BorderBrush="#E7EAF3" BorderThickness="1"
                SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Image Source="/Assets/Brand/waven_logo_dark.png" Height="36" Stretch="Uniform" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Teclado da chamada" FontSize="14" FontWeight="Bold"/>
                        <TextBlock Text="Clique ou digite. O tom é enviado na hora." FontSize="10" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#F3F4F6" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" MinHeight="36" Padding="10,4">
                        <TextBlock x:Name="txtEnviado"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap"/>
                    </Border>
                    <Button Grid.Column="1" Content="✕" Width="28" Height="28" Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButtonStyle}" Padding="0" FontSize="11"
                            ToolTip="Limpar display" Click="Limpar_Click"/>
                </Grid>

                <UniformGrid Grid.Row="2" Rows="4" Columns="3">
                    <Button Tag="1" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="1" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="2" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="2" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="ABC" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="3" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="3" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="DEF" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="4" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="4" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="GHI" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="5" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="5" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="JKL" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="6" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="6" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="MNO" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="7" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="7" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="PQRS" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="8" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="8" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="TUV" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="9" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="9" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="WXYZ" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="*" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="*" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="0" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="0" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Tag="#" Click="Tecla_Click" Style="{StaticResource DtmfKeyStyle}">
                        <StackPanel>
                            <TextBlock Text="#" Style="{StaticResource DtmfKeyNumberStyle}"/>
                            <TextBlock Text="" Style="{StaticResource DtmfKeyLettersStyle}"/>
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <Button Grid.Row="3" Content="Fechar" Height="42" Margin="0,10,0,0" Style="{StaticResource DangerButtonStyle}" Click="Fechar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
