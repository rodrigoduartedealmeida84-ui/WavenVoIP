<Window x:Class="WavenVoIP.Views.DtmfPadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Teclado DTMF"
        Height="520" Width="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Icon="/Assets/wavenvoip.ico"
        Background="#F7FAFC">
    <Grid Margin="16">
        <Border Background="White" CornerRadius="22" Padding="16" BorderBrush="#E7EAF3" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Image Source="/Assets/Brand/waven_logo_dark.png" Height="68" Stretch="Uniform" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Teclado da chamada" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="Clique ou digite. O tom é enviado na hora." Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
                <TextBox Grid.Row="1" x:Name="txtEnviado" Height="48" FontSize="22" IsReadOnly="True" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                <UniformGrid Grid.Row="2" Rows="4" Columns="3">
                    <Button Content="1" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="2" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="3" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="4" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="5" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="6" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="7" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="8" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="9" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="*" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="0" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="#" Click="Tecla_Click" FontSize="24" Margin="5" Style="{StaticResource SecondaryButtonStyle}"/>
                </UniformGrid>
                <Button Grid.Row="3" Content="Fechar" Height="44" Margin="0,12,0,0" Style="{StaticResource PrimaryButtonStyle}" Click="Fechar_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
