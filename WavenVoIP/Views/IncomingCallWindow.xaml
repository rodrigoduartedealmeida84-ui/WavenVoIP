<Window x:Class="WavenVoIP.Views.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamada recebida" Icon="/Assets/wavenvoip.ico"
        Width="392" SizeToContent="Height" WindowStartupLocation="Manual" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Botão de ação: pílula com ícone + texto -->
        <Style x:Key="AcaoChamada" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="fundo" Background="{TemplateBinding Background}" CornerRadius="14"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="fundo" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="12" CornerRadius="22" Background="White" BorderBrush="#E9E5F8" BorderThickness="1">
        <Grid><Border Margin="0" CornerRadius="22" Background="White" IsHitTestVisible="False"><Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.22" Color="#2E1065"/>
        </Border.Effect></Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho roxo: quem está ligando -->
            <Border x:Name="cabecalho" Grid.Row="0" CornerRadius="21,21,0,0" Padding="18,14,12,20"
                    MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C3AED" Offset="0"/>
                        <GradientStop Color="#5B21B6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Border HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="11" Padding="10,4,11,4" Background="#33FFFFFF">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center" Margin="0,0,7,0">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever" Timeline.DesiredFrameRate="12">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.25" Duration="0:0:0.8" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="Chamada recebida" Foreground="White" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30"
                                Click="BtnFechar_Click" ToolTip="Fechar este aviso (a chamada segue tocando nos outros ramais)" Cursor="Hand"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="b" CornerRadius="15" Background="Transparent">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,16,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="60" Height="60" VerticalAlignment="Center">
                            <Ellipse Fill="#33FFFFFF"/>
                            <Ellipse Margin="5" Fill="White"/>
                            <TextBlock x:Name="txtInitials" Text="&#xE717;" Foreground="#6D28D9" FontSize="19" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                            <TextBlock x:Name="txtCallerName" FontSize="19" FontWeight="Bold" Foreground="White"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" LineHeight="25"/>
                            <TextBlock x:Name="txtCallerNumDisplay" FontSize="13.5" Foreground="#E9D5FF" Margin="0,3,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Ações: Recusar | Silenciar | Atender -->
            <Grid Grid.Row="1" Margin="14,14,14,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="1.15*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnRecusar" Grid.Column="0" Style="{StaticResource AcaoChamada}" Background="#EF4444"
                        Click="BtnRecusar_Click" ToolTip="Recusar neste ramal">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE778;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Recusar" FontSize="13.5" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnSilenciar" Grid.Column="2" Style="{StaticResource AcaoChamada}" Background="#F5F3FF"
                        BorderBrush="#DDD6FE" BorderThickness="1"
                        Click="BtnSilenciar_Click" ToolTip="Parar o toque sem recusar a chamada">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74F;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#5B21B6" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock x:Name="txtSilenciar" Text="Silenciar" FontSize="13.5" FontWeight="SemiBold" Foreground="#5B21B6" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnAtender" Grid.Column="4" Style="{StaticResource AcaoChamada}" Background="#16A34A"
                        Click="BtnAtender_Click" ToolTip="Atender a chamada" IsDefault="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Atender" FontSize="13.5" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid></Border>
</Window>
