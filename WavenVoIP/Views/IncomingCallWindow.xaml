<Window x:Class="WavenVoIP.Views.IncomingCallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamada recebida" Icon="/Assets/wavenvoip.ico"
        Height="500" Width="400" WindowStartupLocation="Manual" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow" BlurRadius="32" ShadowDepth="6" Opacity="0.55" Color="#3730A3"/>
        <Style x:Key="RoundActionButton" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#000000" Opacity="0.16" Margin="3,7,3,0"/>
                            <Ellipse x:Name="circle" Fill="{TemplateBinding Background}">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.35" Color="#000000"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="8" CornerRadius="24" BorderBrush="#5B4ADE" BorderThickness="1.5" Effect="{StaticResource CardShadow}">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0E0B2E" Offset="0"/>
                <GradientStop Color="#16124A" Offset="0.50"/>
                <GradientStop Color="#201B62" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Glow ambiente no topo — efeito de profundidade, não bloqueia interação -->
            <Rectangle VerticalAlignment="Top" Height="220" IsHitTestVisible="False" Opacity="0.14"
                       RadiusX="24" RadiusY="24">
                <Rectangle.Fill>
                    <RadialGradientBrush Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.75" RadiusY="0.55">
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Botão Fechar no canto superior direito -->
            <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,12,14,0" Width="30" Height="30"
                    Click="BtnFechar_Click" ToolTip="Fechar" Cursor="Hand"
                    Panel.ZIndex="10">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle" Fill="#EF4444">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.45" Color="#DC2626"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Text="✕" Foreground="White" FontSize="13" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="80"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="108"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Border Grid.Row="0" HorizontalAlignment="Center" CornerRadius="16" Margin="0,6,0,10"
                    Background="White" BorderBrush="#818CF8" BorderThickness="1.5"
                    Width="180" Height="66" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.35" Color="#6366F1"/>
                </Border.Effect>
                <Image Source="/Assets/Brand/waven_logo_dark.png" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True" UseLayoutRounding="True"/>
            </Border>

            <!-- Avatar com anel de chamada -->
            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Anel animado -->
                <Ellipse Width="76" Height="76" Opacity="0.25" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#A78BFA" Offset="0.6"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                     From="1" To="1.5" Duration="0:0:1.2" AutoReverse="True" EasingFunction="{x:Null}"/>
                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                     From="1" To="1.5" Duration="0:0:1.2" AutoReverse="True"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="0.3" To="0" Duration="0:0:1.2" AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <!-- Avatar circle -->
                <Grid Width="64" Height="64">
                    <Ellipse Fill="#1E1B6E" Margin="0,4,0,-4" Opacity="0.5"/>
                    <Ellipse>
                        <Ellipse.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#A78BFA" Offset="0"/>
                                <GradientStop Color="#7C3AED" Offset="0.65"/>
                                <GradientStop Color="#4C1D95" Offset="1"/>
                            </LinearGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="txtInitials" Text="☎" Foreground="White" FontSize="22" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Informações do chamador -->
            <StackPanel Grid.Row="2" VerticalAlignment="Center">
                <Border Background="#1E1B5E" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="10"
                        Padding="10,5" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,7,0">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" Color="#22C55E"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="Chamada recebida" Foreground="#C4B5FD" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
                <Border Padding="14,12" Background="#18165A" CornerRadius="14" BorderBrush="#4338CA" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock x:Name="txtCallerName" FontSize="16" FontWeight="Bold" Foreground="#F1F5F9"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="290"/>
                        <TextBlock x:Name="txtCallerNumDisplay" FontSize="12" Foreground="#A78BFA"
                                   TextAlignment="Center" Margin="0,5,0,0" TextWrapping="Wrap" MaxWidth="290"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Botões: Recusar | Silenciar | Atender -->
            <Grid Grid.Row="3" Margin="4,6,4,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Recusar -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Button Style="{StaticResource RoundActionButton}" Background="#EF4444"
                            Click="BtnRecusar_Click" ToolTip="Recusar chamada">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.4" Color="#EF4444"/>
                        </Button.Effect>
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M20,5.27L18.73,4L12,10.73L5.27,4L4,5.27L10.73,12L4,18.73L5.27,20L12,13.27L18.73,20L20,18.73L13.27,12L20,5.27Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <TextBlock Text="Recusar" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Silenciar -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <Button x:Name="btnSilenciar" Style="{StaticResource RoundActionButton}" Background="#334155"
                            Click="BtnSilenciar_Click" ToolTip="Silenciar toque">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M3.63,3.63C3.24,4.02 3.24,4.65 3.63,5.04L7.29,8.7L7,9H4C3.45,9 3,9.45 3,10V14C3,14.55 3.45,15 4,15H7L11,19V13.41L14.18,16.59C13.69,16.89 13.16,17.14 12.59,17.29C12.22,17.39 12,17.74 12,18.11C12,18.66 12.5,19.07 13.04,18.94C13.83,18.73 14.56,18.38 15.21,17.92L18.95,21.66C19.34,22.05 19.97,22.05 20.36,21.66C20.75,21.27 20.75,20.64 20.36,20.25L5.05,4.94C4.66,4.55 4.02,4.55 3.63,3.63M19,12C19,12.82 18.85,13.61 18.59,14.34L20.12,15.87C20.68,14.7 21,13.39 21,12C21,8.17 18.6,4.9 15.22,3.6L15.22,5.73C17.41,6.89 19,9.27 19,12M11,5L9.91,6.09L13,9.18V5L11,5M16.5,12C16.5,10.23 15.5,8.71 14,7.97L14,10.18L16.45,12.63C16.5,12.43 16.5,12.21 16.5,12Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <TextBlock Text="Silenciar" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Atender -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Button Style="{StaticResource RoundActionButton}" Background="#22C55E"
                            Click="BtnAtender_Click" ToolTip="Atender chamada">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.50" Color="#16A34A"/>
                        </Button.Effect>
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M6.62,10.79C8.06,13.62 10.38,15.93 13.21,17.38L15.41,15.18C15.68,14.91 16.08,14.82 16.43,14.94C17.54,15.31 18.73,15.5 20,15.5C20.55,15.5 21,15.95 21,16.5V20C21,20.55 20.55,21 20,21C10.61,21 3,13.39 3,4C3,3.45 3.45,3 4,3H7.5C8.05,3 8.5,3.45 8.5,4C8.5,5.25 8.7,6.45 9.06,7.57C9.17,7.92 9.08,8.31 8.81,8.59L6.62,10.79Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <TextBlock Text="Atender" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
        </Grid>
        </Grid>
    </Border>
</Window>
