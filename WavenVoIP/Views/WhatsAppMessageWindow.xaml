<Window x:Class="WavenVoIP.Views.WhatsAppMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Enviar WhatsApp" Icon="/Assets/wavenvoip.ico"
        Height="520" Width="580" MinHeight="460" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1E293B"/>
            <Setter Property="BorderBrush"              Value="#DDE3F0"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header verde WhatsApp -->
        <Border Grid.Row="0" Padding="28,20,28,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#075E54" Offset="0"/>
                    <GradientStop Color="#128C7E" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Border Width="46" Height="46" CornerRadius="23" Background="#1DAA61" Margin="0,0,16,0">
                    <Viewbox Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="M12.04,2C6.58,2 2.13,6.45 2.13,11.91C2.13,13.66 2.59,15.37 3.46,16.88L2,22L7.25,20.62C8.71,21.42 10.36,21.84 12.04,21.84H12.05C17.51,21.84 21.96,17.39 21.96,11.93C21.96,9.28 20.93,6.79 19.06,4.92C17.19,3.05 14.7,2 12.04,2ZM12.05,20.16H12.04C10.54,20.16 9.08,19.76 7.81,19L7.51,18.82L4.39,19.64L5.22,16.6L5.02,16.29C4.19,14.97 3.75,13.45 3.75,11.91C3.75,7.34 7.47,3.62 12.04,3.62C14.26,3.62 16.34,4.49 17.91,6.06C19.48,7.63 20.34,9.71 20.34,11.93C20.34,16.5 16.62,20.16 12.05,20.16ZM16.61,13.96C16.36,13.84 15.14,13.24 14.91,13.16C14.68,13.07 14.52,13.03 14.35,13.28C14.19,13.53 13.71,14.08 13.57,14.24C13.42,14.41 13.28,14.43 13.03,14.31C12.78,14.18 11.98,13.92 11.03,13.07C10.29,12.41 9.79,11.59 9.64,11.34C9.5,11.09 9.63,10.95 9.75,10.83C9.86,10.72 10,10.54 10.13,10.39C10.25,10.25 10.29,10.14 10.38,9.98C10.46,9.81 10.42,9.67 10.36,9.55C10.29,9.42 9.8,8.2 9.59,7.71C9.39,7.23 9.19,7.3 9.03,7.29C8.89,7.28 8.72,7.28 8.55,7.28C8.39,7.28 8.12,7.34 7.89,7.59C7.66,7.84 7.03,8.44 7.03,9.66C7.03,10.88 7.92,12.06 8.04,12.22C8.17,12.39 9.79,14.87 12.29,15.94C12.88,16.2 13.35,16.35 13.72,16.46C14.32,16.65 14.86,16.62 15.29,16.56C15.77,16.49 16.76,15.96 16.97,15.38C17.18,14.8 17.18,14.3 17.12,14.2C17.05,14.1 16.86,14.04 16.61,13.96Z"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Enviar WhatsApp" FontSize="21" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Template WABA / Waven Chat" Foreground="#A7F3D0" FontSize="13"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBgBrush}">
            <StackPanel Margin="24,20,24,16">

                <!-- Destinatário -->
                <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Padding="18,16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="DESTINATÁRIO" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>

                        <!-- Avatar + nome (mostrado quando nome disponível) -->
                        <Grid x:Name="panelContatoNome" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="#22C55E" Margin="0,0,14,0" VerticalAlignment="Center">
                                <TextBlock x:Name="txtAvatarInicial" FontSize="22" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="txtNomeContato" FontSize="17" FontWeight="Bold" Foreground="#1E293B"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="txtNumeroFormatado" FontSize="13" Foreground="#16A34A"
                                           FontWeight="SemiBold" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Campo editável (mostrado no modo manual / sem nome) -->
                        <StackPanel x:Name="panelNumeroManual">
                            <TextBox x:Name="txtNumero" Height="44" FontSize="15"
                                     ToolTip="Número com DDD — ex: (66) 98467-1226"/>
                        </StackPanel>

                        <TextBlock x:Name="txtNumeroNormalizado" Foreground="#16A34A" FontSize="12"
                                   FontWeight="SemiBold" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Template WABA -->
                <Border Background="White" CornerRadius="14" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="TEMPLATE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="#DCFCE7" Margin="0,0,14,0" VerticalAlignment="Top">
                                <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#16A34A"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="novo_atendimento" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                <TextBlock Text="Idioma: pt_BR  •  Status: APROVADO" FontSize="12"
                                           Foreground="#16A34A" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="Botão: Continuar Conversa (QUICK_REPLY)" FontSize="12"
                                           Foreground="#0369A1" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock FontSize="12" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="O cliente receberá um convite de atendimento com o botão 'Continuar Conversa'. Aguarde a resposta para continuar o atendimento."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Status de envio -->
                <TextBlock x:Name="txtRetorno" Foreground="{StaticResource MutedBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="2,0,0,4"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                           FontSize="11" Text="Enviado via WABA / Waven Chat" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="Cancelar" MinWidth="100" Height="42" Padding="16,0"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancelar_Click"/>
                <Button x:Name="btnEnviar" Grid.Column="3" Height="42" MinWidth="185" Padding="20,0"
                        Click="BtnEnviar_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Background"   Value="#22C55E"/>
                            <Setter Property="BorderBrush"  Value="#16A34A"/>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Enviar Template" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
