<Window x:Class="WavenVoIP.Views.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contatos" Height="720" Width="1040" MinHeight="640" MinWidth="920"
        WindowStartupLocation="CenterOwner" Icon="/Assets/wavenvoip.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="White" BorderBrush="#E7EAF3" BorderThickness="0,0,1,0" Padding="22">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel>
                    <Image Source="/Assets/Brand/waven_logo_dark.png"
                           Height="64" Stretch="Uniform" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    <TextBlock Text="Waven VoIP" FontSize="22" FontWeight="Bold" Margin="0,16,0,2"/>
                    <TextBlock Text="Agenda rápida" Foreground="{StaticResource MutedBrush}" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Button Content="＋ Novo contato" Style="{StaticResource PrimaryButtonStyle}" Height="48"/>
                    <Button Content="☎ Contatos" Style="{StaticResource NavButtonStyle}" Background="{StaticResource PrimarySoftBrush}" Foreground="{StaticResource PrimaryBrush}"/>
                    <Button Content="↗ Discagem rápida" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Disponível" FontWeight="SemiBold"/>
                    <TextBlock Text="Waven VoIP Active" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="txtTitulo" Text="Contatos" FontSize="32" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSubtitulo" Text="Salve ramais e números externos para discagem rápida." Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Nome do contato" FontWeight="SemiBold" Foreground="#334155" FontSize="14"/>
                        <TextBox x:Name="txtNome" ToolTip="Exemplo: Rodrigo, Suporte, Cliente João"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Número ou ramal" FontWeight="SemiBold" Foreground="#334155" FontSize="14"/>
                        <TextBox x:Name="txtNumero" ToolTip="Ramal interno ou número externo com DDD"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Observação" FontWeight="SemiBold" Foreground="#334155" FontSize="14"/>
                        <TextBox x:Name="txtObs" ToolTip="Exemplo: WhatsApp TIM, fornecedor, financeiro"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="Salvar" Height="48" Width="132" VerticalAlignment="Bottom" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSalvar_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
                <ListView x:Name="gridContatos" BorderThickness="0" Background="Transparent" MouseDoubleClick="GridContatos_MouseDoubleClick" FontSize="15" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="305"/></Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="☎" Foreground="{StaticResource PrimaryBrush}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nome}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Observacao}" Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Numero}" FontSize="16" Foreground="#334155" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Ligar" Click="BtnLigarContato_Click" Tag="{Binding Numero}" Style="{StaticResource PrimaryButtonStyle}" Height="40" Width="78" Padding="10,4"/>
                                        <Button Content="WhatsApp" Click="BtnWhatsAppContato_Click" Tag="{Binding Numero}" Style="{StaticResource SecondaryButtonStyle}" Height="40" Width="100" Padding="10,4" Margin="8,0,0,0"/>
                                        <Button Content="Excluir" Click="BtnExcluirContato_Click" Tag="{Binding}" Style="{StaticResource SoftDangerButtonStyle}" Height="40" Width="78" Padding="10,4" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </Grid>
</Window>
