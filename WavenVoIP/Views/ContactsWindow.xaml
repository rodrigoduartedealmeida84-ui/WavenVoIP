<Window x:Class="WavenVoIP.Views.ContactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contatos" Height="720" Width="1080" MinHeight="640" MinWidth="960"
        WindowStartupLocation="CenterOwner" Icon="/Assets/wavenvoip.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Sidebar esquerda ── -->
        <Border Background="White" BorderBrush="#E7EAF3" BorderThickness="0,0,1,0" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <Image Source="/Assets/Brand/waven_logo_dark.png"
                           Height="64" Stretch="Uniform" HorizontalAlignment="Left"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True" UseLayoutRounding="True"/>
                    <TextBlock Text="Waven VoIP" FontSize="22" FontWeight="Bold" Margin="0,16,0,2"/>
                    <TextBlock Text="Agenda rápida" Foreground="{StaticResource MutedBrush}" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,34,0,0">
                    <Button Content="＋ Novo contato" Style="{StaticResource PrimaryButtonStyle}" Height="48"/>
                    <Button Content="☎ Contatos" Style="{StaticResource NavButtonStyle}"
                            Background="{StaticResource PrimarySoftBrush}" Foreground="{StaticResource PrimaryBrush}"/>
                    <Button Content="↗ Discagem rápida" Style="{StaticResource NavButtonStyle}"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Disponível" FontWeight="SemiBold"/>
                    <TextBlock Text="Waven VoIP Active" Foreground="{StaticResource MutedBrush}" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Painel principal ── -->
        <Grid Grid.Column="1" Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Linha 0: Cabeçalho -->
            <DockPanel Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="txtTitulo" Text="Contatos" FontSize="32" FontWeight="Bold"/>
                    <TextBlock x:Name="txtSubtitulo"
                               Text="Salve ramais e números externos para discagem rápida."
                               Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,4,0,0"/>
                </StackPanel>
            </DockPanel>

            <!-- Linha 1: Formulário de novo contato -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Nome do contato" FontWeight="SemiBold" Foreground="#334155" FontSize="14"/>
                        <TextBox x:Name="txtNome" ToolTip="Exemplo: Rodrigo, Suporte, Cliente João"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Número ou ramal" FontWeight="SemiBold" Foreground="#334155" FontSize="14"/>
                        <TextBox x:Name="txtNumero" ToolTip="Ramal interno ou número externo com DDD"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Observação" FontWeight="SemiBold" Foreground="#334155" FontSize="14"/>
                        <TextBox x:Name="txtObs" ToolTip="Exemplo: WhatsApp TIM, fornecedor, financeiro"/>
                    </StackPanel>
                    <Button Grid.Column="3" Content="Salvar" Height="48" Width="132" VerticalAlignment="Bottom"
                            Style="{StaticResource PrimaryButtonStyle}" Click="BtnSalvar_Click"/>
                </Grid>
            </Border>

            <!-- Linha 2: Barra de busca -->
            <Border Grid.Row="2" Background="White" CornerRadius="12"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                    Padding="16,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="txtBusca" FontSize="14" Padding="2,6"
                                 TextChanged="TxtBusca_TextChanged"
                                 BorderThickness="0" Background="Transparent"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="plcBusca"
                                   Text="🔍  Buscar por nome, número ou observação  (mín. 3 caracteres)"
                                   IsHitTestVisible="False" Padding="2,7" FontSize="14"
                                   Foreground="#94A3B8" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Grid.Column="1" x:Name="txtContagemContatos"
                               Foreground="#94A3B8" FontSize="13" VerticalAlignment="Center"
                               Margin="12,0,2,0"/>
                </Grid>
            </Border>

            <!-- Linha 3: Lista de contatos com virtualização -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="0">
                <ListView x:Name="gridContatos" BorderThickness="0" Background="Transparent"
                          MouseDoubleClick="GridContatos_MouseDoubleClick" FontSize="15"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.IsDeferredScrollingEnabled="False">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="18" BorderBrush="#EEF2F7" BorderThickness="0,0,0,1" Background="White">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.3*"/>
                                        <ColumnDefinition Width="356"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="42" Height="42" CornerRadius="21"
                                            Background="{StaticResource PrimarySoftBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="☎" Foreground="{StaticResource PrimaryBrush}"
                                                   FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nome}" FontWeight="Bold" FontSize="16"/>
                                        <TextBlock Text="{Binding Observacao}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="13" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Numero}" FontSize="16"
                                               Foreground="#334155" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="Ligar" Click="BtnLigarContato_Click"
                                                Tag="{Binding Numero}" Style="{StaticResource PrimaryButtonStyle}"
                                                Height="40" Width="72" Padding="8,4"/>
                                        <Button Content="WhatsApp" Click="BtnWhatsAppContato_Click"
                                                Tag="{Binding Numero}" Style="{StaticResource SecondaryButtonStyle}"
                                                Height="40" Width="95" Padding="8,4" Margin="8,0,0,0"/>
                                        <Button Content="Editar" Click="BtnEditarContato_Click"
                                                Tag="{Binding}" Style="{StaticResource SecondaryButtonStyle}"
                                                Height="40" Width="72" Padding="8,4" Margin="8,0,0,0"/>
                                        <Button Content="Excluir" Click="BtnExcluirContato_Click"
                                                Tag="{Binding}" Style="{StaticResource SoftDangerButtonStyle}"
                                                Height="40" Width="72" Padding="8,4" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <!-- ── Toast: desfazer exclusão (canto inferior direito) ── -->
        <Border x:Name="toastContainer" Grid.Column="1"
                VerticalAlignment="Bottom" HorizontalAlignment="Right"
                Margin="0,0,40,40" Panel.ZIndex="999" Visibility="Collapsed">
            <Border Background="#1E293B" CornerRadius="12" Padding="18,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.35" Color="#000000"/>
                </Border.Effect>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✓" Foreground="#4ADE80" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="txtToastMsg" Text="Contato excluído."
                               Foreground="White" FontSize="14" VerticalAlignment="Center"/>
                    <Button x:Name="btnDesfazer" Content="DESFAZER"
                            Click="BtnDesfazer_Click"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#60A5FA" FontWeight="Bold" FontSize="13"
                            Margin="18,0,0,0" Cursor="Hand" Padding="0"
                            VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
