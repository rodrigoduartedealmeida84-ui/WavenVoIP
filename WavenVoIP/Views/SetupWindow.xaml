<Window x:Class="WavenVoIP.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:WavenVoIP.Services"
        Title="Waven VoIP — Configuração"
        Icon="/Assets/wavenvoip.ico"
        Height="620" Width="900"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        SnapsToDevicePixels="True" UseLayoutRounding="True">

    <Window.Resources>
        <!-- Local styles for setup form — NO Template setter so WPF uses its default
             theme template, which is guaranteed to accept keyboard input correctly. -->
        <Style x:Key="SetupTxt" TargetType="TextBox">
            <Setter Property="Height"                   Value="44"/>
            <Setter Property="Foreground"               Value="#111827"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#CBD5E1"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Padding"                  Value="12,0"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        </Style>
        <Style x:Key="SetupPwd" TargetType="PasswordBox">
            <Setter Property="Height"                   Value="44"/>
            <Setter Property="Foreground"               Value="#111827"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="BorderBrush"              Value="#CBD5E1"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Padding"                  Value="12,10"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── LEFT BRAND PANEL ──────────────────────────────────────── -->
        <Border Grid.Column="0" CornerRadius="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1E0B3E" Offset="0"/>
                    <GradientStop Color="#2D1060" Offset="0.5"/>
                    <GradientStop Color="#3B0F8F" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel VerticalAlignment="Center" Margin="30,0">
                    <!-- Logo -->
                    <Border Width="200" Height="68" ClipToBounds="True"
                            Background="White" CornerRadius="16" Margin="0,0,0,32">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.30" Color="#7C3AED"/>
                        </Border.Effect>
                        <Image Source="/Assets/Brand/waven_logo_dark.png" Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>

                    <TextBlock x:Name="txtTitulo"
                               Text="Configuração inicial"
                               FontSize="22" FontWeight="Bold" Foreground="White"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock x:Name="txtSubtitulo"
                               Text="Informe suas credenciais SIP para conectar o softphone."
                               FontSize="13" Foreground="#C4B5FD"
                               TextWrapping="Wrap" LineHeight="20"/>

                    <!-- Feature list -->
                    <StackPanel Margin="0,28,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#4C1D95" Margin="0,0,10,0">
                                <TextBlock Text="✓" Foreground="#A78BFA" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chamadas SIP via Issabel/Asterisk"
                                       Foreground="#DDD6FE" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#4C1D95" Margin="0,0,10,0">
                                <TextBlock Text="✓" Foreground="#A78BFA" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Histórico real de CDR via MySQL"
                                       Foreground="#DDD6FE" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#4C1D95" Margin="0,0,10,0">
                                <TextBlock Text="✓" Foreground="#A78BFA" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Sincronização AMI de ramais"
                                       Foreground="#DDD6FE" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12" Background="#4C1D95" Margin="0,0,10,0">
                                <TextBlock Text="✓" Foreground="#A78BFA" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Integração WhatsApp e Google"
                                       Foreground="#DDD6FE" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Version footer -->
                <TextBlock Grid.Row="1" Margin="30,0,30,20"
                           Text="{x:Static svc:VersionService.VersaoCompleta}"
                           Foreground="#6B5A9E" FontSize="11"/>
            </Grid>
        </Border>

        <!-- ── RIGHT FORM PANEL ──────────────────────────────────────── -->
        <Grid Grid.Column="1" Background="{StaticResource WindowBgBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="36,24,36,14" BorderBrush="{StaticResource BorderSoftBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="Dados de acesso"
                               FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="Preencha os campos obrigatórios (*) para entrar. Demais configurações já vêm com os padrões da empresa."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="36,18,36,16">

                    <!-- ── CAMPOS OBRIGATÓRIOS ── -->
                    <TextBlock Text="Conta do operador"
                               FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Nome do operador *" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                    <TextBox x:Name="txtNomeOperador"
                             Style="{StaticResource SetupTxt}"
                             Margin="0,0,0,12"/>

                    <UniformGrid Columns="2" Margin="0,0,0,0">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Ramal *" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="txtRamal"
                                     Style="{StaticResource SetupTxt}"
                                     Margin="0,0,0,12"/>
                        </StackPanel>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="Login / Auth User *" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                            <TextBox x:Name="txtLogin"
                                     Style="{StaticResource SetupTxt}"
                                     Margin="0,0,0,12"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Senha SIP *" FontSize="13" FontWeight="SemiBold"
                               Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                    <PasswordBox x:Name="txtSenha"
                                 Style="{StaticResource SetupPwd}"
                                 Margin="0,0,0,18"/>

                    <!-- ── CONFIGURAÇÕES AVANÇADAS (Expander) ── -->
                    <Border BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1"
                            CornerRadius="8" Margin="0,0,0,8">
                        <Expander x:Name="expanderAvancado" IsExpanded="False" Padding="14,10,14,14">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                    <TextBlock Text="Configurações avançadas"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text=" — padrão da empresa"
                                               FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Expander.Header>

                            <StackPanel Margin="0,10,0,0">

                                <!-- Servidor SIP -->
                                <TextBlock Text="Conexão SIP"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Servidor SIP" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                                        <TextBox x:Name="txtServidor"
                                                 Style="{StaticResource SetupTxt}"
                                                 Margin="0,0,0,12"
                                                 TextChanged="TxtServidor_TextChanged"/>
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Porta SIP" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                                        <TextBox x:Name="txtPorta"
                                                 Style="{StaticResource SetupTxt}"
                                                 Margin="0,0,0,12"/>
                                    </StackPanel>
                                </UniformGrid>

                                <TextBlock Text="Domínio SIP" FontSize="13" FontWeight="SemiBold"
                                           Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                                <TextBox x:Name="txtDominio"
                                         Style="{StaticResource SetupTxt}"
                                         Margin="0,0,0,14"/>

                                <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,14"/>

                                <!-- AMI -->
                                <TextBlock Text="Asterisk Manager Interface (AMI)"
                                           FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,4"/>
                                <TextBlock Text="Sincronização automática de ramais e chamadas."
                                           Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12"/>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Host AMI" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                                        <TextBox x:Name="txtAmiHost"
                                                 Style="{StaticResource SetupTxt}"
                                                 Margin="0,0,0,12"/>
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Porta AMI" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                                        <TextBox x:Name="txtAmiPorta"
                                                 Style="{StaticResource SetupTxt}"
                                                 Margin="0,0,0,12"/>
                                    </StackPanel>
                                </UniformGrid>

                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,10,0">
                                        <TextBlock Text="Usuário AMI" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                                        <TextBox x:Name="txtAmiUsuario"
                                                 Style="{StaticResource SetupTxt}"/>
                                    </StackPanel>
                                    <StackPanel Margin="10,0,0,0">
                                        <TextBlock Text="Senha AMI" FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,0,0,4" Foreground="{StaticResource TextBrush}"/>
                                        <PasswordBox x:Name="txtAmiSenha"
                                                     Style="{StaticResource SetupPwd}"/>
                                    </StackPanel>
                                </UniformGrid>

                            </StackPanel>
                        </Expander>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="36,14" Background="White"
                    BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Error / status -->
                    <Border x:Name="errorBox" Visibility="Collapsed"
                            Background="#FFF1F2" BorderBrush="#FECACA" BorderThickness="1"
                            CornerRadius="10" Padding="12,8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠ " Foreground="#DC2626" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtErro" Foreground="#DC2626" FontSize="13"
                                       TextWrapping="Wrap" MaxWidth="320" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="btnTestar"
                                Content="Testar conexão"
                                Height="44" MinWidth="148" Padding="16,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="BtnTestar_Click" Margin="0,0,10,0"/>
                        <Button x:Name="btnSalvar"
                                Content="Salvar e entrar →"
                                Height="44" MinWidth="160" Padding="16,0"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnSalvar_Click" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
