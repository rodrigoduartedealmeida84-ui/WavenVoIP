<Window x:Class="WavenVoIP.Views.OutboundDeclinedToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamada recusada"
        Height="136" Width="360"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="toastRoot"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.2"/>
                    <ThicknessAnimation Storyboard.TargetName="toastRoot"
                                        Storyboard.TargetProperty="Margin"
                                        From="8,22,8,6" To="8,6,8,6"
                                        Duration="0:0:0.2">
                        <ThicknessAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Border x:Name="toastRoot" Margin="8,6,8,6"
            Background="White" CornerRadius="14"
            BorderBrush="#FECACA" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>

        <Grid Margin="12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="32"/>
            </Grid.ColumnDefinitions>

            <!-- Ícone chamada recusada -->
            <Border Width="34" Height="34" CornerRadius="17" Background="#FEE2E2"
                    VerticalAlignment="Top" Margin="0,2,0,0">
                <TextBlock Text="⊘" Foreground="#B91C1C" FontSize="16" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Texto -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0">
                <TextBlock Text="Chamada recusada" FontSize="12" FontWeight="Bold" Foreground="#B91C1C"/>
                <TextBlock x:Name="txtNome" Margin="0,3,0,0" FontSize="13" FontWeight="SemiBold"
                           Foreground="#1E293B" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtNumero" Margin="0,1,0,0" FontSize="12"
                           Foreground="#64748B" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="O cliente recusou a chamada." Margin="0,6,0,0" FontSize="11.5"
                           Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Botão Fechar -->
            <Button Grid.Column="2" Click="Close_Click" Cursor="Hand"
                    Width="26" Height="26" VerticalAlignment="Top" HorizontalAlignment="Right"
                    ToolTip="Fechar">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="circle" Fill="#EF4444"/>
                            <TextBlock Text="✕" Foreground="White" FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="circle" Property="Fill" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</Window>
