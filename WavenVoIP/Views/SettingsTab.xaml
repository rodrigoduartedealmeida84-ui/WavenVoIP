<UserControl x:Class="WavenVoIP.Views.SettingsTab"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="14">
            <StackPanel>
                <Border Padding="16" Margin="0,0,0,14" Background="#FFFFFF" BorderBrush="#E3E8F5" BorderThickness="1" CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="Áudio e chamada recebida" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

                        <TextBlock Text="Microfone" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbMicrofone" Margin="0,6,0,14">
                            <ComboBoxItem Content="Padrão do sistema"/>
                        </ComboBox>

                        <TextBlock Text="Alto-falante" FontWeight="Bold"/>
                        <ComboBox x:Name="cmbAltoFalante" Margin="0,6,0,14">
                            <ComboBoxItem Content="Padrão do sistema"/>
                        </ComboBox>

                        <TextBlock Text="Toque" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,14">
                            <TextBox x:Name="txtToque" Width="360"/>
                            <Button Content="Trocar" Width="100" Margin="8,0,0,0" Click="BtnTrocarToque_Click"/>
                        </StackPanel>

                        <CheckBox x:Name="chkInvadirTela"
                                  Content="Chamada recebida invade qualquer tela"
                                  Margin="0,0,0,14"/>
                    </StackPanel>
                </Border>

                <Border Padding="16" Margin="0,0,0,14" Background="#FFFFFF" BorderBrush="#E3E8F5" BorderThickness="1" CornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="WhatsApp / Waven Chat" FontSize="20" FontWeight="Bold" Margin="0,0,0,6"/>
                        <TextBlock Text="Configure a API ZPRO/Waven Chat usada pelos botões de WhatsApp em contatos, histórico e chamada."
                                   Foreground="#5F6B85" TextWrapping="Wrap" Margin="0,0,0,14"/>

                        <TextBlock Text="URL da API" FontWeight="Bold"/>
                        <TextBox x:Name="txtWhatsAppApiUrl" Margin="0,6,0,12" Height="34"/>

                        <TextBlock Text="Bearer Token" FontWeight="Bold"/>
                        <PasswordBox x:Name="txtWhatsAppBearerToken" Margin="0,6,0,12" Height="34"/>

                        <TextBlock Text="Número de teste" FontWeight="Bold"/>
                        <TextBox x:Name="txtWhatsAppNumeroTeste" Margin="0,6,0,12" Height="34"/>

                        <TextBlock Text="Mensagem de teste" FontWeight="Bold"/>
                        <TextBox x:Name="txtWhatsAppMensagemTeste" Margin="0,6,0,12" Height="74" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button x:Name="btnWhatsAppTeste" Content="Enviar teste" Width="140" Height="38" Click="BtnWhatsAppTeste_Click"/>
                            <TextBlock x:Name="txtWhatsAppStatus" Margin="12,9,0,0" Foreground="#5F6B85" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button Content="Salvar configurações" Width="190" Height="40" Click="BtnSalvar_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
