<UserControl x:Class="WavenVoIP.Views.FilasRealtimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <DataTemplate x:Key="FilaCardTemplate">
            <Border Background="{Binding CorFundoCard}"
                    BorderBrush="{Binding CorBordaCard}"
                    BorderThickness="1.5"
                    CornerRadius="16"
                    Padding="18,14"
                    Margin="0,0,14,14"
                    Width="310"
                    MinHeight="180">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.07" Color="#000000"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Header: fila + aguardando badge -->
                    <DockPanel Margin="0,0,0,12">
                        <Border DockPanel.Dock="Right"
                                Background="{Binding CorAguardando}"
                                CornerRadius="12"
                                Padding="10,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x23F3; " FontSize="11" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="{Binding TextoAguardando}"
                                           FontSize="11" FontWeight="Bold" Foreground="White"/>
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Fila}"
                                       FontSize="22" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding Nome}"
                                       FontSize="11" Foreground="#64748B"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>

                    <Rectangle Height="1" Fill="#E2E8F0" Margin="0,0,0,12"/>

                    <!-- Estatísticas: agentes -->
                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,10">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding AgentesOnline}"
                                       FontSize="20" FontWeight="Bold" Foreground="#16A34A"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Online" FontSize="9" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding AgentesEmAtendimento}"
                                       FontSize="20" FontWeight="Bold" Foreground="#2563EB"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Atendendo" FontSize="9" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding AgentesPausados}"
                                       FontSize="20" FontWeight="Bold" Foreground="#D97706"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Pausados" FontSize="9" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding AgentesOffline}"
                                       FontSize="20" FontWeight="Bold" Foreground="#DC2626"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Offline" FontSize="9" Foreground="#64748B"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Rodapé: totais de chamadas -->
                    <Border Background="#F8FAFC" CornerRadius="10" Padding="10,7" Margin="0,4,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <TextBlock Text="Atendidas: " FontSize="10" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Atendidas}" FontSize="10" FontWeight="Bold" Foreground="#16A34A"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Abandono: " FontSize="10" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Abandonadas}" FontSize="10" FontWeight="Bold" Foreground="#DC2626"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#1E293B"
                CornerRadius="16"
                Padding="20,14"
                Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                        <Path Fill="White" Data="M17,12V3A1,1 0 0,0 16,2H3A1,1 0 0,0 2,3V17L6,13H16A1,1 0 0,0 17,12M21,6H19V15H6V17A1,1 0 0,0 7,18H18L22,22V7A1,1 0 0,0 21,6Z"/>
                    </Viewbox>
                    <TextBlock Text="Filas em Tempo Real" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border x:Name="bdConexaoFilas" CornerRadius="10" Padding="8,3" Margin="14,0,0,0"
                            Background="#4B5563" VerticalAlignment="Center">
                        <TextBlock x:Name="txtStatusFilas" Text="● Aguardando"
                                   FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnAtualizarFilas"
                            Content="↻ Atualizar"
                            Height="30" Padding="12,0"
                            FontSize="11" FontWeight="SemiBold" Cursor="Hand"
                            Background="#2D3B52" Foreground="White" BorderBrush="#4B5563" BorderThickness="1"
                            Margin="0,0,10,0"
                            Click="BtnAtualizarFilas_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock x:Name="txtAtualizadoFilas"
                               FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Cards de filas -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="icFilas" ItemTemplate="{StaticResource FilaCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <TextBlock x:Name="txtVazioFilas"
                           Text="Aguardando dados de filas..."
                           FontSize="14" Foreground="#94A3B8"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,60,0,0"
                           Visibility="Visible"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
