<Window x:Class="WavenVoIP.Views.ChamadasAguardandoPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clientes aguardando" Width="410" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="BotaoX" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Width="28" Height="28" CornerRadius="14" Background="#26FFFFFF">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#EF4444"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotaoPuxar" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Padding="13,8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#8B5CF6" Offset="0"/>
                                    <GradientStop Color="#6D28D9" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.74"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotaoLink" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#6D28D9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="8,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#EDE9FE"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="16" BorderBrush="#DDD6FE" BorderThickness="1" Margin="12">
        <Grid><Border Margin="0" CornerRadius="16" Background="White" IsHitTestVisible="False"><Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.25" Color="#4C1D95"/>
        </Border.Effect></Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho (arraste para mover) -->
            <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="16,12" MouseLeftButtonDown="Cabecalho_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7C3AED" Offset="0"/>
                        <GradientStop Color="#5B21B6" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource BotaoX}" ToolTip="Fechar este aviso" Click="BtnDispensarTodos_Click" VerticalAlignment="Center"/>
                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="#33FFFFFF" Margin="0,0,11,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="txtTitulo" Text="Cliente aguardando na fila" Foreground="White" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="Nenhum atendente atendeu ainda" Foreground="#E9D5FF" FontSize="11.5"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="lista" Margin="12,10,12,2">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAF9FF" BorderBrush="#EEEAFB" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Cliente}" FontSize="14.5" FontWeight="Bold" Foreground="#1E1B4B" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Telefone}" FontSize="12" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        <WrapPanel Margin="0,7,0,0">
                                            <Border Background="{Binding CorFundo}" CornerRadius="8" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding Cor}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                            <Border Background="#F1F5F9" CornerRadius="8" Padding="8,3" Margin="0,0,6,0">
                                                <TextBlock Text="{Binding Canal}" FontSize="11" Foreground="#475569"/>
                                            </Border>
                                            <TextBlock Text="{Binding Duracao}" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Puxar Ligação" Style="{StaticResource BotaoPuxar}" Tag="{Binding}" Click="BtnPuxar_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Grid.Row="2" x:Name="txtStatus" Margin="18,0,18,6" FontSize="11.5" FontWeight="SemiBold" Foreground="#4C1D95" TextWrapping="Wrap" Visibility="Collapsed"/>

            <Border Grid.Row="3" BorderBrush="#F1EEFB" BorderThickness="0,1,0,0" Padding="10,6,10,8">
                <Button Content="Ver Puxar Ligação  ›" Style="{StaticResource BotaoLink}" HorizontalAlignment="Center" Click="BtnVerTudo_Click"
                        ToolTip="Abrir a janela completa com todas as ligações em andamento"/>
            </Border>
        </Grid>
    </Grid></Border>
</Window>
