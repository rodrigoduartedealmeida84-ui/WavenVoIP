<Window x:Class="WavenVoIP.Views.MissedCallPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamada perdida"
        Width="340" Height="160"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Border Background="White" CornerRadius="16"
            BorderBrush="#FECACA" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="18,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock Text="📵  Chamada perdida" FontSize="13" FontWeight="Bold"
                           Foreground="#DC2626" Margin="0,0,0,4"/>
                <TextBlock x:Name="txtCallerName" Text="" FontSize="15" FontWeight="SemiBold"
                           Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtCallerNumber" Text="" FontSize="12"
                           Foreground="#64748B" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal">
                <Button x:Name="btnRetornar" Content="↩  Retornar" Height="32" Padding="14,0"
                        FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnRetornar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#7C3AED" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="0,0,0,1"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground><SolidColorBrush Color="White"/></Button.Foreground>
                </Button>

                <Button Content="Histórico" Height="32" Padding="14,0" Margin="8,0,0,0"
                        FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnVerHistorico_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground><SolidColorBrush Color="#475569"/></Button.Foreground>
                </Button>

                <Button Content="✕" Height="32" Width="32" Margin="8,0,0,0"
                        FontSize="13" Cursor="Hand"
                        HorizontalAlignment="Right"
                        Click="BtnFechar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground><SolidColorBrush Color="#94A3B8"/></Button.Foreground>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
