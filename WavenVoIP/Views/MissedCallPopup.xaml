<Window x:Class="WavenVoIP.Views.MissedCallPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamada perdida"
        Width="360" Height="190"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">

    <Border Background="White" CornerRadius="16"
            BorderBrush="#FECACA" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.20" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabeçalho -->
            <Border Grid.Row="0" Background="#FEF2F2" CornerRadius="16,16,0,0" Padding="14,10,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="28" Height="28" CornerRadius="14" Background="#FEE2E2" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="↘" Foreground="#DC2626" FontSize="14" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Chamada perdida" FontSize="13" FontWeight="Bold"
                                   Foreground="#DC2626" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Botão Fechar -->
                    <Button Grid.Column="1" Click="BtnFechar_Click" Cursor="Hand"
                            Width="28" Height="28" ToolTip="Fechar"
                            VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Ellipse x:Name="circle" Fill="#EF4444"/>
                                    <TextBlock Text="✕" Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="circle" Property="Fill" Value="#DC2626"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="circle" Property="Fill" Value="#B91C1C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Informações do chamador -->
            <StackPanel Grid.Row="1" Margin="16,12,16,8" VerticalAlignment="Center">
                <TextBlock x:Name="txtCallerName" FontSize="15" FontWeight="SemiBold"
                           Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="txtCallerNumber" FontSize="12"
                           Foreground="#64748B" Margin="0,3,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- Botões de ação — Grid para largura igual -->
            <Grid Grid.Row="2" Margin="16,0,16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="btnRetornar" Height="34"
                        FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnRetornar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#7C3AED" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#5B21B6"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground><SolidColorBrush Color="White"/></Button.Foreground>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="↩" FontSize="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Retornar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Height="34"
                        FontSize="12" FontWeight="SemiBold" Cursor="Hand"
                        Click="BtnVerHistorico_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground><SolidColorBrush Color="#475569"/></Button.Foreground>
                    <TextBlock Text="Histórico" HorizontalAlignment="Center"/>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
