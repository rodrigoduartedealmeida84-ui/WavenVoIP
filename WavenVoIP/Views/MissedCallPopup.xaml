<Window x:Class="WavenVoIP.Views.MissedCallPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chamada não atendida"
        Width="380" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <!-- v2.5.0 — aviso fixo de chamada não atendida (Perdida, Cliente desistiu, Abandono na fila):
         cliente, telefone, horário e canal; Retornar pelo mesmo canal e WhatsApp.
         Cartão branco com contorno em degradê (rosa → violeta). Ícones são vetores (fonte do Windows e
         o logotipo do WhatsApp em Path), nítidos em qualquer escala. A sombra fica num Border
         irmão (e não no pai) para o texto não borrar. -->
    <Window.Resources>
        <!-- Logotipo do WhatsApp (glifo oficial, viewBox 24x24) -->
        <Geometry x:Key="WhatsAppLogo">M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1 -5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1 -1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0 -3.48-8.413Z</Geometry>

        <Style x:Key="Rotulo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Valor" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="IconeLinha" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!-- sombra num Border irmão: o texto do cartão não é rasterizado -->
        <Border CornerRadius="16" Background="White" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.16" Color="#1E1B4B"/>
            </Border.Effect>
        </Border>

        <!-- contorno em degradê -->
        <Border CornerRadius="16" BorderThickness="1.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F43F5E" Offset="0"/>
                    <GradientStop Color="#C026D3" Offset="0.45"/>
                    <GradientStop Color="#7C3AED" Offset="0.75"/>
                    <GradientStop Color="#C7D2FE" Offset="1"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FFF5F7" Offset="0"/>
                    <GradientStop Color="#FFFFFF" Offset="0.32"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cabeçalho -->
                <Grid Grid.Row="0" Margin="18,16,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" CornerRadius="12" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FB7185" Offset="0"/>
                                <GradientStop Color="#E11D48" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE778;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Chamada não atendida" FontSize="14" FontWeight="SemiBold" Foreground="#0F172A"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border Background="#FFE4E6" CornerRadius="8" Padding="8,2">
                                <TextBlock x:Name="txtMotivo" Text="Perdida" FontSize="11" FontWeight="SemiBold" Foreground="#BE123C"
                                           TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                            </Border>
                            <!-- só aparece no aviso de demonstração (ver Demonstracao) -->
                            <Border x:Name="bdDemo" Visibility="Collapsed" Background="#F5F3FF" BorderBrush="#DDD6FE" BorderThickness="1"
                                    CornerRadius="8" Padding="7,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="DEMONSTRAÇÃO" FontSize="9" FontWeight="Bold" Foreground="#6D28D9"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="3" Click="BtnFechar_Click" Cursor="Hand" Width="28" Height="28"
                            ToolTip="Fechar o aviso" VerticalAlignment="Top">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" CornerRadius="9">
                                    <TextBlock x:Name="x" Text="&#xE711;" FontFamily="Segoe MDL2 Assets" Foreground="#94A3B8" FontSize="10"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                        <Setter TargetName="x" Property="Foreground" Value="#DC2626"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Cliente, telefone, horário e canal -->
                <StackPanel Grid.Row="1" Margin="18,16,18,0">
                    <TextBlock x:Name="txtCallerName" FontSize="18" FontWeight="SemiBold"
                               Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                    <Border Background="#F8FAFC" BorderBrush="#EEF2F7" BorderThickness="1" CornerRadius="12" Padding="12,4" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="28"/>
                                <RowDefinition Height="1"/>
                                <RowDefinition Height="28"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="&#xE717;" Style="{StaticResource IconeLinha}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Telefone" Style="{StaticResource Rotulo}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" x:Name="txtCallerNumber" Style="{StaticResource Valor}"/>
                            <Rectangle Grid.Row="1" Grid.ColumnSpan="3" Fill="#EEF2F7"/>

                            <TextBlock Grid.Row="2" Text="&#xE823;" Style="{StaticResource IconeLinha}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="Horário" Style="{StaticResource Rotulo}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" x:Name="txtHorario" Style="{StaticResource Valor}"/>
                            <Rectangle Grid.Row="3" Grid.ColumnSpan="3" Fill="#EEF2F7"/>

                            <TextBlock Grid.Row="4" Text="&#xE8AB;" Style="{StaticResource IconeLinha}"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="Canal" Style="{StaticResource Rotulo}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" x:Name="txtCanal" Style="{StaticResource Valor}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Ações -->
                <StackPanel Grid.Row="2" Margin="18,14,18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" x:Name="btnRetornar" Height="42" Cursor="Hand" Click="BtnRetornar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="11">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                                <GradientStop Color="#6D28D9" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#5B21B6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE717;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                <TextBlock Text="Retornar" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2" x:Name="btnWhatsApp" Height="42" Cursor="Hand" Click="BtnWhatsApp_Click"
                                ToolTip="Abrir a conversa do WhatsApp com este número. O aviso continua aberto.">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="11">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#F0FDF4"/>
                                            <Setter TargetName="bd" Property="BorderBrush" Value="#25D366"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#DCFCE7"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel Orientation="Horizontal">
                                <Path x:Name="logoWhatsApp" Data="{StaticResource WhatsAppLogo}" Fill="#25D366" Stretch="Uniform"
                                      Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="WhatsApp" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Rectangle Height="1" Fill="#F1F5F9" Margin="0,14,0,0"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtCanalRetorno" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Click="BtnVerHistorico_Click" Cursor="Hand" ToolTip="Abrir o Histórico neste número">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <StackPanel Orientation="Horizontal" Background="Transparent">
                                        <TextBlock x:Name="t" Text="Ver no Histórico" FontSize="11" FontWeight="SemiBold" Foreground="#7C3AED" VerticalAlignment="Center"/>
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="#7C3AED" VerticalAlignment="Center" Margin="5,1,0,0"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="t" Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
