<UserControl x:Class="WavenVoIP.Views.RamaisRealtimeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <Style x:Key="FilterChip" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Background"      Value="#F1F5F9"/>
            <Setter Property="Foreground"      Value="#475569"/>
            <Setter Property="BorderBrush"     Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="17">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ramal card template — compacto em repouso, expandido em ligação -->
        <DataTemplate x:Key="RamalCardTemplate">
            <Border Background="{Binding CorStatusFundo}"
                    BorderBrush="{Binding CorStatusBorda}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="14,12"
                    Margin="0,0,10,10"
                    Width="292"
                    Opacity="{Binding Opacidade}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.07" Color="#000000"/>
                </Border.Effect>
                <StackPanel>

                    <!-- Linha superior: dot + ramal/nome + badge de status -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="10" Height="10" CornerRadius="5"
                                Background="{Binding CorStatus}"
                                VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Ramal}"
                                       FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding Nome}"
                                       FontSize="11" Foreground="#64748B"
                                       Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Background="{Binding CorStatus}"
                                CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusTexto}"
                                       FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </Grid>

                    <!-- Seção de chamada (visível apenas quando em ligação/tocando/chamando) -->
                    <StackPanel Visibility="{Binding EstaEmLigacao, Converter={StaticResource B2V}}">
                        <Separator Height="1" Background="#E2E8F0" Margin="0,9,0,9"/>

                        <!-- Badge de direção: ↙ ENTRADA (azul) ou ↗ SAÍDA (laranja) -->
                        <Border Background="{Binding CorDirecao}"
                                CornerRadius="6" Padding="8,3"
                                HorizontalAlignment="Left" Margin="0,0,0,8">
                            <TextBlock Text="{Binding DirecaoTexto}"
                                       FontSize="10" FontWeight="Bold" Foreground="White"/>
                        </Border>

                        <!-- Número de origem ou destino -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelNumero}"
                                       FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding NumeroRemoto}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding NumeroRemoto}"/>
                        </Grid>

                        <!-- Linha/canal usada (colapsada quando não há info) -->
                        <Grid Margin="0,0,0,4"
                              Visibility="{Binding TemInfoLinha, Converter={StaticResource B2V}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding LabelLinha}"
                                       FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding InfoLinha}"
                                       FontSize="11" Foreground="#475569"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding InfoLinha}"/>
                        </Grid>

                        <!-- Duração -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Duração:"
                                       FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Duracao}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="#1E293B"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header ──────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="#1E293B"
                CornerRadius="16"
                Padding="20,14"
                Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20" Margin="0,0,10,0">
                        <Path Fill="White" Data="M17,12H7V10H17M14,17H7V15H14M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z"/>
                    </Viewbox>
                    <TextBlock Text="Painel de Ramais" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border x:Name="bdConexao" CornerRadius="10" Padding="8,3" Margin="14,0,0,0"
                            Background="#4B5563" VerticalAlignment="Center">
                        <TextBlock x:Name="txtStatusConexao" Text="● Aguardando"
                                   FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Live counters -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Online -->
                    <Border Background="#0F172A" CornerRadius="12" Padding="14,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#22C55E" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtOnlineCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#22C55E"/>
                            <TextBlock Text=" Online" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </Border>
                    <!-- Em ligação -->
                    <Border Background="#0F172A" CornerRadius="12" Padding="14,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#3B82F6" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtEmLigacaoCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#3B82F6"/>
                            <TextBlock Text=" Em ligação" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </Border>
                    <!-- Tocando -->
                    <Border Background="#0F172A" CornerRadius="12" Padding="14,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#F59E0B" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtTocandoCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"/>
                            <TextBlock Text=" Tocando" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </Border>
                    <!-- Offline (apenas ramais confirmados sem registro) -->
                    <Border Background="#0F172A" CornerRadius="12" Padding="14,8" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#EF4444" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtOfflineCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text=" Offline" FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </Border>
                    <!-- Indisponível (sem status real — API básica ou ramal sem contato AMI) -->
                    <Border Background="#0F172A" CornerRadius="12" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="4" Background="#6B7280" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="txtIndispCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#6B7280"/>
                            <TextBlock Text=" Indisp." FontSize="11" Foreground="#64748B" VerticalAlignment="Bottom" Margin="2,0,0,2"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Banner de aviso (modo básico / erro) ───────────────────────── -->
        <Border x:Name="bdAviso" Grid.Row="1"
                Background="#FEF9C3" BorderBrush="#FDE047" BorderThickness="1"
                CornerRadius="10" Padding="14,9" Margin="0,0,0,10"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠  " FontSize="12" Foreground="#854D0E" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtAviso" FontSize="12" Foreground="#854D0E"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── Search + Filters ────────────────────────────────────────────── -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search box -->
            <Border Grid.Column="0"
                    Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                    CornerRadius="10" Height="34">
                <DockPanel Margin="10,0">
                    <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                               FontSize="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="txtBusca"
                             BorderThickness="0" Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="12" Foreground="#1E293B"
                             ToolTip="Buscar por ramal ou nome"
                             TextChanged="TxtBusca_TextChanged"/>
                </DockPanel>
            </Border>

            <!-- Filter dropdown button -->
            <Button x:Name="btnFiltroDropdown"
                    Grid.Column="2"
                    Style="{StaticResource FilterChip}"
                    Content="Filtros ▾"
                    Margin="10,0,8,0"
                    Click="BtnFiltroDropdown_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Tag="Todos"        Header="Todos"          Click="FiltroMenu_Click"/>
                        <MenuItem Tag="Online"       Header="● Online"       Click="FiltroMenu_Click"/>
                        <MenuItem Tag="EmLigacao"    Header="● Em ligação"   Click="FiltroMenu_Click"/>
                        <MenuItem Tag="Tocando"      Header="● Tocando"      Click="FiltroMenu_Click"/>
                        <MenuItem Tag="Offline"      Header="● Offline"      Click="FiltroMenu_Click"/>
                        <MenuItem Tag="Indisponivel" Header="● Indisponível" Click="FiltroMenu_Click"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>

            <!-- Refresh + Last updated -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnAtualizar"
                        Content="↻  Atualizar"
                        Height="34" Padding="14,0"
                        FontSize="12.5" FontWeight="SemiBold" Cursor="Hand"
                        Background="#7C3AED" Foreground="White" BorderBrush="#7C3AED" BorderThickness="0"
                        Margin="0,0,10,0"
                        Click="BtnAtualizar_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.68"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <TextBlock x:Name="txtAtualizado"
                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ── Ramal cards ─────────────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl x:Name="icRamais"
                              ItemTemplate="{StaticResource RamalCardTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Empty state -->
                <TextBlock x:Name="txtVazio"
                           Text="Aguardando conexão AMI..."
                           FontSize="14" Foreground="#94A3B8"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="0,60,0,0"
                           Visibility="Visible"/>
            </Grid>
        </ScrollViewer>

    </Grid>
</UserControl>
