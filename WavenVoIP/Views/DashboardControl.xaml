<UserControl x:Class="WavenVoIP.Views.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E7EAF3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header + date filters -->
        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Left" Text="Dashboard Operacional"
                       FontSize="20" FontWeight="Bold" Foreground="#1E293B"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnFiltroHoje" Content="Hoje"
                        Background="#7C3AED" Foreground="White" BorderBrush="#7C3AED"
                        Style="{StaticResource FilterBtn}" Margin="0,0,6,0"
                        Click="BtnFiltroHoje_Click"/>
                <Button x:Name="btnFiltroOntem" Content="Ontem"
                        Background="#F3F4F6" Foreground="#475569" BorderBrush="#E2E8F0"
                        Style="{StaticResource FilterBtn}" Margin="0,0,6,0"
                        Click="BtnFiltroOntem_Click"/>
                <Button x:Name="btnFiltro7d" Content="7 dias"
                        Background="#F3F4F6" Foreground="#475569" BorderBrush="#E2E8F0"
                        Style="{StaticResource FilterBtn}" Margin="0,0,6,0"
                        Click="BtnFiltro7d_Click"/>
                <Button x:Name="btnFiltro30d" Content="30 dias"
                        Background="#F3F4F6" Foreground="#475569" BorderBrush="#E2E8F0"
                        Style="{StaticResource FilterBtn}" Margin="0,0,14,0"
                        Click="BtnFiltro30d_Click"/>
                <!-- Período personalizado -->
                <DatePicker x:Name="dpInicio" Width="116" Height="30" Margin="0,0,4,0"
                            VerticalAlignment="Center" SelectedDateFormat="Short"/>
                <TextBlock Text="até" VerticalAlignment="Center" Margin="0,0,4,0"
                           FontSize="12" Foreground="#64748B"/>
                <DatePicker x:Name="dpFim" Width="116" Height="30" Margin="0,0,6,0"
                            VerticalAlignment="Center" SelectedDateFormat="Short"/>
                <Button x:Name="btnAplicarPeriodo" Content="Aplicar"
                        Background="#EDE9FE" Foreground="#5B21B6" BorderBrush="#DDD6FE"
                        Style="{StaticResource FilterBtn}" Margin="0,0,14,0"
                        Click="BtnAplicarPeriodo_Click"/>
                <Button x:Name="btnAtualizar" Content="↻  Atualizar"
                        Background="#F0FDF4" Foreground="#15803D" BorderBrush="#BBF7D0"
                        Style="{StaticResource FilterBtn}"
                        Click="BtnAtualizar_Click"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtPeriodo" Text="" Foreground="#64748B" FontSize="12"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
                <TextBlock x:Name="txtAtualizadoAs" Text="" Foreground="#94A3B8" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Metric cards row -->
        <UniformGrid Grid.Row="1" Rows="1" Columns="6" Margin="0,0,0,14">
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Recebidas" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtRecebidas" Text="—" FontSize="28" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Realizadas" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtRealizadas" Text="—" FontSize="28" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Perdidas" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtPerdidas" Text="—" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTotal" Text="—" FontSize="28" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Tempo médio" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtTempoMedio" Text="—" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="Gravações" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                    <TextBlock x:Name="txtGravacoes" Text="—" FontSize="28" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Bar chart -->
        <Border Grid.Row="2" Background="White" CornerRadius="14"
                BorderBrush="#E7EAF3" BorderThickness="1"
                Padding="14,12" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Chamadas por hora" FontSize="13" FontWeight="SemiBold"
                           Foreground="#1E293B" Margin="0,0,0,10"/>
                <ItemsControl x:Name="icChamadasPorHora">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="36" Margin="1,0">
                                <StackPanel.ToolTip>
                                    <ToolTip Content="{Binding Tooltip}"/>
                                </StackPanel.ToolTip>
                                <!-- spacer pushes bar to bottom -->
                                <Rectangle Height="{Binding EspacadorAltura}" Fill="Transparent"/>
                                <Rectangle Height="{Binding AlturaBar}" RadiusX="3" RadiusY="3">
                                    <Rectangle.Fill>
                                        <SolidColorBrush Color="#7C3AED" Opacity="0.75"/>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <TextBlock Text="{Binding ContagemLabel}" FontSize="9"
                                           Foreground="#7C3AED" HorizontalAlignment="Center"
                                           Margin="0,2,0,0"/>
                                <TextBlock Text="{Binding HoraLabel}" FontSize="9"
                                           Foreground="#94A3B8" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Ramal performance table -->
        <Border Grid.Row="3" Background="White" CornerRadius="14"
                BorderBrush="#E7EAF3" BorderThickness="1" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Performance por ramal" FontSize="13" FontWeight="SemiBold"
                               Foreground="#1E293B" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtBuscaRamal" DockPanel.Dock="Right"
                             Width="200" Height="30" VerticalContentAlignment="Center"
                             Padding="8,0" FontSize="12"
                             ToolTip="Filtrar por ramal ou nome"
                             TextChanged="TxtBuscaRamal_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Border Background="White" CornerRadius="8"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </DockPanel>

                <DataGrid x:Name="gridRamais" Grid.Row="1"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="True"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          Background="White"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFBFF"
                          HeadersVisibility="Column"
                          ColumnHeaderHeight="36"
                          RowHeight="36"
                          FontSize="12">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontSize" Value="11"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderBrush" Value="#E7EAF3"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="10,0"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="#1E293B"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#EDE9FE"/>
                                    <Setter Property="Foreground" Value="#5B21B6"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Ramal"     Binding="{Binding Ramal}"      Width="80"/>
                        <DataGridTextColumn Header="Nome"      Binding="{Binding Nome}"       Width="*"/>
                        <DataGridTextColumn Header="Recebidas" Binding="{Binding Recebidas}"  Width="90"/>
                        <DataGridTextColumn Header="Realizadas" Binding="{Binding Realizadas}" Width="90"/>
                        <DataGridTextColumn Header="Perdidas"  Binding="{Binding Perdidas}"   Width="90"/>
                        <DataGridTextColumn Header="Total"     Binding="{Binding Total}"      Width="80"/>
                        <DataGridTextColumn Header="Tempo médio" Binding="{Binding TempoMedio}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
