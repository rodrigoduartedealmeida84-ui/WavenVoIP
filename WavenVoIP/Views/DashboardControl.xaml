<UserControl x:Class="WavenVoIP.Views.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WavenVoIP.Views"
             xmlns:models="clr-namespace:WavenVoIP.Models">

    <UserControl.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderBrush" Value="#E7EAF3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,14"/>
        </Style>
        <Style x:Key="LiveCard" TargetType="Border" BasedOn="{StaticResource MetricCard}">
            <Setter Property="BorderBrush" Value="#DDD6FE"/>
        </Style>

        <!-- FilterBtn: botões de período (Hoje / Ontem / 7d / 30d) -->
        <Style x:Key="FilterBtn" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="18,0"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabBtn: abas principais (Métricas / Ramais ao Vivo / Filas) -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Height"          Value="40"/>
            <Setter Property="Padding"         Value="24,0"/>
            <Setter Property="FontSize"        Value="13.5"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ModernDatePicker: DatePicker com cantos arredondados e ícone roxo.
             Mantém os três PART_ obrigatórios: PART_TextBox, PART_Button, PART_Popup. -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Height"              Value="36"/>
            <Setter Property="Width"               Value="126"/>
            <Setter Property="VerticalAlignment"   Value="Center"/>
            <Setter Property="SelectedDateFormat"  Value="Short"/>
            <Setter Property="Background"          Value="White"/>
            <Setter Property="Foreground"          Value="#1E293B"/>
            <Setter Property="FontSize"            Value="12.5"/>
            <Setter Property="Padding"             Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#E2E8F0" BorderThickness="1"
                                CornerRadius="10" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>

                                <!-- Campo de texto da data -->
                                <DatePickerTextBox x:Name="PART_TextBox"
                                                   Grid.Column="0"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   Foreground="{TemplateBinding Foreground}"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   VerticalAlignment="Center"
                                                   Padding="10,0,0,0"
                                                   Focusable="True"/>

                                <!-- Botão calendário -->
                                <Button x:Name="PART_Button"
                                        Grid.Column="1"
                                        Focusable="False"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Width="26" Height="26"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="iconBd"
                                                    Background="Transparent"
                                                    CornerRadius="7">
                                                <TextBlock Text="&#xE787;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Foreground="#7C3AED"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="iconBd" Property="Background" Value="#EDE9FE"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="iconBd" Property="Background" Value="#DDD6FE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Popup do calendário — conteúdo injetado pelo DatePicker -->
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       Placement="Bottom"
                                       StaysOpen="False"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Focus: borda roxa -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7C3AED"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <!-- Hover: borda lilás suave -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#A78BFA"/>
                            </Trigger>
                            <!-- Desabilitado -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: título + atualizar -->
            <RowDefinition Height="Auto"/>   <!-- 1: filtros de período -->
            <RowDefinition Height="Auto"/>   <!-- 2: abas -->
            <RowDefinition Height="*"/>      <!-- 3: conteúdo -->
        </Grid.RowDefinitions>

        <!-- ── Título + botão Atualizar ──────────────────────────────────── -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Text="Dashboard Operacional"
                       FontSize="20" FontWeight="Bold" Foreground="#1E293B"
                       VerticalAlignment="Center"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="txtAtualizadoAs" Text="" Foreground="#94A3B8" FontSize="11"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="txtPeriodo" Text="" Foreground="#64748B" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Button x:Name="btnAtualizar"
                        Content="↻  Atualizar"
                        Background="#16A34A" Foreground="White" BorderBrush="#16A34A"
                        Style="{StaticResource FilterBtn}"
                        Click="BtnAtualizar_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- ── Filtros de período ────────────────────────────────────────── -->
        <StackPanel x:Name="pnlFiltrosPeriodo" Grid.Row="1"
                    Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="btnFiltroHoje"  Content="Hoje"
                    Background="#7C3AED" Foreground="White" BorderBrush="#7C3AED"
                    Style="{StaticResource FilterBtn}" Margin="0,0,6,0"
                    Click="BtnFiltroHoje_Click"/>
            <Button x:Name="btnFiltroOntem" Content="Ontem"
                    Background="#F1F5F9" Foreground="#475569" BorderBrush="#E2E8F0"
                    Style="{StaticResource FilterBtn}" Margin="0,0,6,0"
                    Click="BtnFiltroOntem_Click"/>
            <Button x:Name="btnFiltro7d"    Content="7 dias"
                    Background="#F1F5F9" Foreground="#475569" BorderBrush="#E2E8F0"
                    Style="{StaticResource FilterBtn}" Margin="0,0,6,0"
                    Click="BtnFiltro7d_Click"/>
            <Button x:Name="btnFiltro30d"   Content="30 dias"
                    Background="#F1F5F9" Foreground="#475569" BorderBrush="#E2E8F0"
                    Style="{StaticResource FilterBtn}" Margin="0,0,16,0"
                    Click="BtnFiltro30d_Click"/>
            <!-- Separador visual -->
            <Border Width="1" Background="#E2E8F0" Margin="0,4,16,4" VerticalAlignment="Stretch"/>
            <!-- Intervalo de datas com estilo moderno -->
            <DatePicker x:Name="dpInicio" Style="{StaticResource ModernDatePicker}" Margin="0,0,8,0"/>
            <TextBlock Text="até" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontSize="12.5" FontWeight="Medium" Foreground="#64748B"/>
            <DatePicker x:Name="dpFim"   Style="{StaticResource ModernDatePicker}" Margin="0,0,10,0"/>
            <Button x:Name="btnAplicarPeriodo" Content="Aplicar"
                    Background="#7C3AED" Foreground="White" BorderBrush="#7C3AED"
                    Style="{StaticResource FilterBtn}"
                    Click="BtnAplicarPeriodo_Click"/>
        </StackPanel>

        <!-- ── Abas ──────────────────────────────────────────────────────── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,14">
            <Button x:Name="btnTabMetricas"
                    Content="Métricas"
                    Background="#7C3AED" Foreground="White" BorderBrush="#7C3AED"
                    Style="{StaticResource TabBtn}"
                    Margin="0,0,8,0"
                    Click="BtnTabMetricas_Click"/>
            <Button x:Name="btnTabRamais"
                    Content="Ramais ao Vivo"
                    Background="#F1F5F9" Foreground="#475569" BorderBrush="#E2E8F0"
                    Style="{StaticResource TabBtn}"
                    Margin="0,0,8,0"
                    Click="BtnTabRamais_Click"/>
            <Button x:Name="btnTabFilas"
                    Content="Filas em Tempo Real"
                    Background="#F1F5F9" Foreground="#475569" BorderBrush="#E2E8F0"
                    Style="{StaticResource TabBtn}"
                    Click="BtnTabFilas_Click"/>
        </StackPanel>

        <!-- ── Área de conteúdo ──────────────────────────────────────────── -->
        <Grid Grid.Row="3">

            <!-- Panel Métricas (ScrollViewer) -->
            <ScrollViewer x:Name="scrollMetricas"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Visible">
                <StackPanel>

                    <!-- CDR metric cards -->
                    <UniformGrid Rows="1" Columns="6" Margin="0,0,0,10">
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Recebidas" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtRecebidas" Text="—" FontSize="28" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                                <TextBlock Text="chamadas" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Realizadas" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtRealizadas" Text="—" FontSize="28" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                                <TextBlock Text="chamadas" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Perdidas" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtPerdidas" Text="—" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                                <TextBlock Text="chamadas" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Total atendidas" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtTotal" Text="—" FontSize="28" FontWeight="Bold" Foreground="#7C3AED" Margin="0,4,0,0"/>
                                <TextBlock Text="chamadas" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="Tempo médio" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtTempoMedio" Text="—" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,6,0,0"/>
                                <TextBlock Text="por atendimento" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource MetricCard}">
                            <StackPanel>
                                <TextBlock Text="Gravações" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtGravacoes" Text="—" FontSize="28" FontWeight="Bold" Foreground="#EA580C" Margin="0,4,0,0"/>
                                <TextBlock Text="arquivos" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Live AMI status cards -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                            <TextBlock Text="● AO VIVO" FontSize="9" FontWeight="Bold" Foreground="#7C3AED"/>
                            <TextBlock Text="Ramais" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="via AMI" FontSize="10" Foreground="#94A3B8"/>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource LiveCard}" Margin="0,0,10,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="4" Background="#22C55E" CornerRadius="2,0,0,2" Margin="-16,-14,-4,-14"/>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Online" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtRamaisOnline" Text="—" FontSize="28" FontWeight="Bold" Foreground="#16A34A" Margin="0,4,0,0"/>
                                    <TextBlock Text="ramais livres" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource LiveCard}" Margin="0,0,10,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="4" Background="#3B82F6" CornerRadius="2,0,0,2" Margin="-16,-14,-4,-14"/>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Em ligação" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtRamaisEmLigacao" Text="—" FontSize="28" FontWeight="Bold" Foreground="#2563EB" Margin="0,4,0,0"/>
                                    <TextBlock Text="ramais ocupados" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource LiveCard}">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="4" Background="#EF4444" CornerRadius="2,0,0,2" Margin="-16,-14,-4,-14"/>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock Text="Offline" FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtRamaisOffline" Text="—" FontSize="28" FontWeight="Bold" Foreground="#DC2626" Margin="0,4,0,0"/>
                                    <TextBlock Text="ramais offline" FontSize="10" Foreground="#CBD5E1" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Bar chart -->
                    <Border Background="White" CornerRadius="14"
                            BorderBrush="#E7EAF3" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Chamadas por hora" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#1E293B" Margin="0,0,0,10"/>
                            <ItemsControl x:Name="icChamadasPorHora">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="36" Margin="1,0">
                                            <StackPanel.ToolTip>
                                                <ToolTip Content="{Binding Tooltip}"/>
                                            </StackPanel.ToolTip>
                                            <Rectangle Height="{Binding EspacadorAltura}" Fill="Transparent"/>
                                            <Rectangle Height="{Binding AlturaBar}" RadiusX="3" RadiusY="3">
                                                <Rectangle.Fill>
                                                    <SolidColorBrush Color="#7C3AED" Opacity="0.75"/>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                            <TextBlock Text="{Binding ContagemLabel}" FontSize="9"
                                                       Foreground="#7C3AED" HorizontalAlignment="Center"
                                                       Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding HoraLabel}" FontSize="9"
                                                       Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Performance table -->
                    <Border Background="White" CornerRadius="14"
                            BorderBrush="#E7EAF3" BorderThickness="1"
                            Padding="14,12" Margin="0,0,0,4">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <TextBlock Text="Performance por ramal" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#1E293B" VerticalAlignment="Center"/>
                                <TextBox x:Name="txtBuscaRamal" DockPanel.Dock="Right"
                                         Width="200" Height="30" VerticalContentAlignment="Center"
                                         Padding="8,0" FontSize="12"
                                         ToolTip="Filtrar por ramal ou nome"
                                         TextChanged="TxtBuscaRamal_TextChanged">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Border Background="White" CornerRadius="8"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                            <ScrollViewer x:Name="PART_ContentHost" Margin="4,0"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </DockPanel>

                            <DataGrid x:Name="gridRamais"
                                      AutoGenerateColumns="False"
                                      CanUserSortColumns="True"
                                      IsReadOnly="True"
                                      MinHeight="120"
                                      MaxHeight="340"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#F1F5F9"
                                      Background="White"
                                      BorderThickness="0"
                                      RowBackground="White"
                                      AlternatingRowBackground="#FAFBFF"
                                      HeadersVisibility="Column"
                                      ColumnHeaderHeight="36"
                                      RowHeight="36"
                                      FontSize="12">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,0"/>
                                        <Setter Property="BorderBrush" Value="#E7EAF3"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="#1E293B"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}"
                                                            Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#EDE9FE"/>
                                                <Setter Property="Foreground" Value="#5B21B6"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Ramal"       Binding="{Binding Ramal}"      Width="80"/>
                                    <DataGridTextColumn Header="Nome"        Binding="{Binding Nome}"       Width="*"/>
                                    <DataGridTextColumn Header="Recebidas"   Binding="{Binding Recebidas}"  Width="90"/>
                                    <DataGridTextColumn Header="Realizadas"  Binding="{Binding Realizadas}" Width="90"/>
                                    <DataGridTextColumn Header="Perdidas"    Binding="{Binding Perdidas}"   Width="90"/>
                                    <DataGridTextColumn Header="Total"       Binding="{Binding Total}"      Width="80"/>
                                    <DataGridTextColumn Header="Tempo médio" Binding="{Binding TempoMedio}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Panel Ramais ao Vivo -->
            <local:RamaisRealtimeControl x:Name="ramaisTab"
                                         Visibility="Collapsed"/>

            <!-- Panel Filas em Tempo Real -->
            <local:FilasRealtimeControl x:Name="filasTab"
                                        Visibility="Collapsed"/>

        </Grid>
    </Grid>
</UserControl>
