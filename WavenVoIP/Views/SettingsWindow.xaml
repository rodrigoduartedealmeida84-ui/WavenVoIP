<Window x:Class="WavenVoIP.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:WavenVoIP.Services"
        Title="Configurações — Waven VoIP" Icon="/Assets/wavenvoip.ico"
        Height="740" Width="800" MinHeight="600" MinWidth="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- Estilos locais SEM template customizado — garante input funcional via template nativo WPF -->
        <Style TargetType="TextBox">
            <Setter Property="Height"                   Value="44"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1E293B"/>
            <Setter Property="BorderBrush"              Value="#DDE3F0"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Margin"                   Value="0,4,0,0"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height"                   Value="44"/>
            <Setter Property="Padding"                  Value="10,0"/>
            <Setter Property="FontSize"                 Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#1E293B"/>
            <Setter Property="BorderBrush"              Value="#DDE3F0"/>
            <Setter Property="BorderThickness"          Value="1.5"/>
            <Setter Property="Margin"                   Value="0,4,0,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="32,22,32,18">
            <StackPanel>
                <TextBlock Text="Configurações" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock Text="Áudio, notificações, inicialização e integrações" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBgBrush}">
            <StackPanel Margin="32,24,32,24">

                <!-- ── Status das Integrações ───────────────────────── -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="#F0FDF4" CornerRadius="16,16,0,0" Padding="22,14" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#DCFCE7" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#16A34A"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Status das Integrações" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Conexão atual de cada integração — reconexão manual" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="22,16,22,20">

                            <!-- Google Contacts -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotGoogle" Width="10" Height="10" VerticalAlignment="Center" Fill="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="Google Contacts" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock x:Name="txtIntGoogle" Grid.Column="2" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal">
                                    <Button x:Name="btnIntConectarGoogle" Content="Conectar" Height="30" Padding="12,0" FontSize="12"
                                            Style="{StaticResource SecondaryButtonStyle}" Click="BtnIntConectarGoogle_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="btnIntDesconectarGoogle" Content="Desconectar" Height="30" Padding="12,0" FontSize="12"
                                            Background="#FFF1F2" Foreground="#DC2626" BorderBrush="#FECACA" BorderThickness="1.5"
                                            Click="BtnIntDesconectarGoogle_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,12"/>

                            <!-- WhatsApp -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotWhatsApp" Width="10" Height="10" VerticalAlignment="Center" Fill="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="WhatsApp" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock x:Name="txtIntWhatsApp" Grid.Column="2" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="btnIntTestarWhatsApp" Grid.Column="3" Content="Testar" Height="30" Padding="12,0" FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnIntTestarWhatsApp_Click"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,12"/>

                            <!-- AMI -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotAmi" Width="10" Height="10" VerticalAlignment="Center" Fill="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="AMI (Asterisk)" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock x:Name="txtIntAmi" Grid.Column="2" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="btnIntReconectarAmi" Grid.Column="3" Content="Reconectar AMI" Height="30" Padding="12,0" FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnIntReconectarAmi_Click"/>
                            </Grid>

                            <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,12"/>

                            <!-- CDR -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="dotCdr" Width="10" Height="10" VerticalAlignment="Center" Fill="#94A3B8"/>
                                <TextBlock Grid.Column="1" Text="CDR MySQL" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                <TextBlock x:Name="txtIntCdr" Grid.Column="2" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                                <Button x:Name="btnIntReconectarCdr" Grid.Column="3" Content="Reconectar CDR" Height="30" Padding="12,0" FontSize="12"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnIntReconectarCdr_Click"/>
                            </Grid>

                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── SIP / Conexão ──────────────────────────────────── -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="#F5F3FF" CornerRadius="16,16,0,0" Padding="22,14" BorderBrush="#DDD6FE" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#EDE9FE" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7C3AED"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Conexão SIP / AMI" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Servidor, porta, domínio e Asterisk Manager Interface" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="22,16,22,20">
                            <TextBlock Text="SIP" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Servidor SIP" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtSipServidor" Margin="0,0,0,12"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Porta SIP" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtSipPorta" Margin="0,0,0,12"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="Domínio SIP" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtSipDominio" Margin="0,0,0,16"/>

                            <Border Height="1" Background="{StaticResource BorderSoftBrush}" Margin="0,0,0,14"/>

                            <TextBlock Text="AMI — Asterisk Manager Interface" FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Host AMI" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtSipAmiHost" Margin="0,0,0,12"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Porta AMI" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtSipAmiPorta" Margin="0,0,0,12"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Usuário AMI" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtSipAmiUsuario"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Senha AMI" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="txtSipAmiSenha"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="btnTestarAmi" Content="Testar AMI" Height="38" Padding="16,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnTestarAmi_Click"/>
                                <TextBlock x:Name="txtAmiResultado" VerticalAlignment="Center" FontSize="13"
                                           TextWrapping="Wrap" Margin="14,0,0,0" MaxWidth="380"/>
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Intervalo de atualização AMI:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                <ComboBox x:Name="cmbAmiSyncInterval" Grid.Column="1" Height="38">
                                    <ComboBoxItem Tag="0"  Content="Manual (não atualiza automaticamente)"/>
                                    <ComboBoxItem Tag="3"  Content="3 segundos"/>
                                    <ComboBoxItem Tag="5"  Content="5 segundos"/>
                                    <ComboBoxItem Tag="10" Content="10 segundos"/>
                                    <ComboBoxItem Tag="15" Content="15 segundos"/>
                                    <ComboBoxItem Tag="30" Content="30 segundos"/>
                                    <ComboBoxItem Tag="60" Content="1 minuto"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── CDR / Histórico ───────────────────────────────── -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="#F0F9FF" CornerRadius="16,16,0,0" Padding="22,14" BorderBrush="#BAE6FD" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#E0F2FE" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0284C7"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="CDR — Histórico via MySQL" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Conexão com o banco de dados do Issabel/Asterisk" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="22,16,22,20">
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="14,12" Margin="0,0,0,14" BorderBrush="#E7EAF3" BorderThickness="1">
                                <CheckBox x:Name="chkCdrAtivo">
                                    <TextBlock Text="Ativar sincronização CDR via MySQL" FontSize="13" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                </CheckBox>
                            </Border>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Host MySQL" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtCdrHost" Margin="0,0,0,12"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Porta MySQL" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtCdrPorta" Margin="0,0,0,12"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Banco" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtCdrBanco" Margin="0,0,0,12"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Tabela" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtCdrTabela" Margin="0,0,0,12"/>
                                </StackPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Usuário" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <TextBox x:Name="txtCdrUsuario"/>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock Text="Senha" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <PasswordBox x:Name="txtCdrSenha"/>
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="btnTestarCdr" Content="Testar CDR / MySQL" Height="38" Padding="16,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnTestarCdr_Click"/>
                                <TextBlock x:Name="txtCdrResultado" VerticalAlignment="Center" FontSize="13"
                                           TextWrapping="Wrap" Margin="14,0,0,0" MaxWidth="380"/>
                            </StackPanel>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Modo de exibição do histórico:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                <ComboBox x:Name="cmbHistoricoModo" Grid.Column="1" Height="38">
                                    <ComboBoxItem Tag="MeuRamal"    Content="Meu ramal"/>
                                    <ComboBoxItem Tag="TodosRamais" Content="Todos os ramais"/>
                                </ComboBox>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Intervalo de atualização CDR:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                <ComboBox x:Name="cmbCdrSyncInterval" Grid.Column="1" Height="38">
                                    <ComboBoxItem Tag="0"  Content="Manual (não atualiza automaticamente)"/>
                                    <ComboBoxItem Tag="3"  Content="3 segundos"/>
                                    <ComboBoxItem Tag="5"  Content="5 segundos"/>
                                    <ComboBoxItem Tag="10" Content="10 segundos"/>
                                    <ComboBoxItem Tag="15" Content="15 segundos"/>
                                    <ComboBoxItem Tag="30" Content="30 segundos"/>
                                    <ComboBoxItem Tag="60" Content="1 minuto"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Áudio -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="#F8FAFC" CornerRadius="16,16,0,0" Padding="22,14,22,14" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#EDE9FE" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#7C3AED"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Áudio" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Microfone, alto-falante e toque de chamada" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="22,16,22,20">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Microfone" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cmbMicrofone"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Alto-falante" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cmbAltoFalante"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Toque de chamada" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="txtToque" Grid.Column="0" Margin="0"/>
                                <Button Grid.Column="2" Content="Trocar..." Height="46" Style="{StaticResource SecondaryButtonStyle}" Click="BtnTrocarToque_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Sistema -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="#F8FAFC" CornerRadius="16,16,0,0" Padding="22,14,22,14" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#DBEAFE" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1D4ED8"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sistema" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Comportamento do aplicativo e inicialização" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="22,16,22,20">
                            <Border Background="#FAFAFA" CornerRadius="12" Padding="16,14" Margin="0,0,0,10" BorderBrush="#E7EAF3" BorderThickness="1">
                                <CheckBox x:Name="chkInvadirTela">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Mostrar tela de chamada em destaque" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Ao receber uma chamada, a janela aparece sobre outros aplicativos" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Background="#FAFAFA" CornerRadius="12" Padding="16,14" Margin="0,0,0,12" BorderBrush="#E7EAF3" BorderThickness="1">
                                <CheckBox x:Name="chkIniciarWindows">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Iniciar com o Windows" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="O Waven VoIP inicia automaticamente quando o Windows liga" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <TextBlock Text="Fechar a janela principal não encerra o aplicativo — ele continua ativo na bandeja do sistema para receber chamadas."
                                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="2,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Google Contacts ───────────────────────────────── -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="#EFF6FF" CornerRadius="16,16,0,0" Padding="22,14" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#DBEAFE" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#1D4ED8"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Google Contacts" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Sincronização de contatos via OAuth2" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="22,16,22,20">
                            <TextBlock FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="A autenticação Google usa OAuth2. Na primeira vez abre o navegador para autorizar. O token fica salvo localmente."/>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Intervalo de atualização Google:" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="0,0,14,0"/>
                                <ComboBox x:Name="cmbGoogleSyncInterval" Grid.Column="1" Height="38">
                                    <ComboBoxItem Tag="0"  Content="Manual (não atualiza automaticamente)"/>
                                    <ComboBoxItem Tag="3"  Content="3 segundos"/>
                                    <ComboBoxItem Tag="5"  Content="5 segundos"/>
                                    <ComboBoxItem Tag="10" Content="10 segundos"/>
                                    <ComboBoxItem Tag="15" Content="15 segundos"/>
                                    <ComboBoxItem Tag="30" Content="30 segundos"/>
                                    <ComboBoxItem Tag="60" Content="1 minuto"/>
                                </ComboBox>
                            </Grid>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnTestarGoogle" Content="Testar Google Contatos" Height="38" Padding="16,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnTestarGoogle_Click"/>
                                <TextBlock x:Name="txtGoogleResultado" VerticalAlignment="Center" FontSize="13"
                                           TextWrapping="Wrap" Margin="14,0,0,0" MaxWidth="380"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- WhatsApp -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel>
                        <Border Background="#F0FDF4" CornerRadius="16,16,0,0" Padding="22,14,22,14" BorderBrush="#BBF7D0" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#22C55E" Margin="0,0,14,0">
                                    <Viewbox Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White" Data="M12.04,2C6.58,2 2.13,6.45 2.13,11.91C2.13,13.66 2.59,15.37 3.46,16.88L2,22L7.25,20.62C8.71,21.42 10.36,21.84 12.04,21.84H12.05C17.51,21.84 21.96,17.39 21.96,11.93C21.96,9.28 20.93,6.79 19.06,4.92C17.19,3.05 14.7,2 12.04,2ZM12.05,20.16H12.04C10.54,20.16 9.08,19.76 7.81,19L7.51,18.82L4.39,19.64L5.22,16.6L5.02,16.29C4.19,14.97 3.75,13.45 3.75,11.91C3.75,7.34 7.47,3.62 12.04,3.62C14.26,3.62 16.34,4.49 17.91,6.06C19.48,7.63 20.34,9.71 20.34,11.93C20.34,16.5 16.62,20.16 12.05,20.16ZM16.61,13.96C16.36,13.84 15.14,13.24 14.91,13.16C14.68,13.07 14.52,13.03 14.35,13.28C14.19,13.53 13.71,14.08 13.57,14.24C13.42,14.41 13.28,14.43 13.03,14.31C12.78,14.18 11.98,13.92 11.03,13.07C10.29,12.41 9.79,11.59 9.64,11.34C9.5,11.09 9.63,10.95 9.75,10.83C9.86,10.72 10,10.54 10.13,10.39C10.25,10.25 10.29,10.14 10.38,9.98C10.46,9.81 10.42,9.67 10.36,9.55C10.29,9.42 9.8,8.2 9.59,7.71C9.39,7.23 9.19,7.3 9.03,7.29C8.89,7.28 8.72,7.28 8.55,7.28C8.39,7.28 8.12,7.34 7.89,7.59C7.66,7.84 7.03,8.44 7.03,9.66C7.03,10.88 7.92,12.06 8.04,12.22C8.17,12.39 9.79,14.87 12.29,15.94C12.88,16.2 13.35,16.35 13.72,16.46C14.32,16.65 14.86,16.62 15.29,16.56C15.77,16.49 16.76,15.96 16.97,15.38C17.18,14.8 17.18,14.3 17.12,14.2C17.05,14.1 16.86,14.04 16.61,13.96Z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Integração WhatsApp" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="ZPRO / Waven Chat — URL e autenticação" FontSize="12" Foreground="#16A34A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="22,16,22,20">
                            <TextBlock Text="URL da API" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <TextBox x:Name="txtWhatsApiUrl" Height="44" Margin="0,0,0,12" ToolTip="Exemplo: https://api.wavenchat.com.br/v2/api/external/SEU_API_ID"/>
                            <TextBlock Text="Bearer Token" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6"/>
                            <PasswordBox x:Name="txtWhatsToken" Height="44" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button x:Name="btnTestarWhatsConexao" Content="Testar Conexão WhatsApp" Height="38" Padding="16,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnTestarWhatsConexao_Click"/>
                                <TextBlock x:Name="txtWhatsConexaoResultado" VerticalAlignment="Center" FontSize="13"
                                           TextWrapping="Wrap" Margin="14,0,0,0" MaxWidth="300"/>
                            </StackPanel>
                            <Border Background="#F0FDF4" CornerRadius="12" Padding="16,14" BorderBrush="#BBF7D0" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Teste de envio" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="1.3*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Número" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtWhatsNumeroTeste" Height="42" Margin="0" ToolTip="(66) 98467-1226"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Mensagem" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="txtWhatsMensagemTeste" Height="42" Margin="0"/>
                                        </StackPanel>
                                        <Button x:Name="btnEnviarTesteWhatsApp" Grid.Column="4" Content="Enviar" Height="42" VerticalAlignment="Bottom" Style="{StaticResource SecondaryButtonStyle}" Click="BtnEnviarTesteWhatsApp_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="txtWhatsResultado" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ── Atualizações ──────────────────────────────────── -->
                <Border Background="White" CornerRadius="16" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="1" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Background="#F0F9FF" CornerRadius="16,16,0,0" Padding="22,14" BorderBrush="#BAE6FD" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#E0F2FE" Margin="0,0,14,0">
                                    <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#0284C7"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Atualizações" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="Controle de versão e atualizações automáticas" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Margin="22,16,22,20">

                            <!-- Warning: last update failed -->
                            <Border x:Name="borderUpdateFailed" Visibility="Collapsed"
                                    Background="#FFF1F2" BorderBrush="#FECACA" BorderThickness="1"
                                    CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x26A0; " Foreground="#DC2626" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Foreground="#DC2626" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                               Text="A última atualização falhou. Atualizações automáticas foram pausadas. Use o botão abaixo para limpar ou verificar manualmente."/>
                                </StackPanel>
                            </Border>

                            <Border Background="#F8FAFC" CornerRadius="12" Padding="16,14" Margin="0,0,0,16" BorderBrush="#E7EAF3" BorderThickness="1">
                                <CheckBox x:Name="chkAutoUpdate">
                                    <StackPanel Margin="6,0,0,0">
                                        <TextBlock Text="Ativar atualizações automáticas" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="O aplicativo verifica e instala atualizações automaticamente ao iniciar" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </Border>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Versão atual:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBlock x:Name="txtUpdateVerLocal" Grid.Row="0" Grid.Column="1" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,20,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Versão no servidor:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBlock x:Name="txtUpdateVerRemota" Grid.Row="0" Grid.Column="3" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Última verificação:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtUpdateUltimaVer" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" FontSize="12" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="txtUpdateStatus" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="{StaticResource MutedBrush}"/>

                            <ProgressBar x:Name="progressUpdate" Height="6" IsIndeterminate="True"
                                         Visibility="Collapsed" Margin="0,0,0,12"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="btnVerificarUpdate" Content="Verificar atualização agora" Height="38" Padding="16,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnVerificarUpdate_Click" Margin="0,0,10,0"/>
                                <Button x:Name="btnLimparFlagUpdate" Content="Limpar falha de atualização" Height="38" Padding="14,0"
                                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnLimparFlagUpdate_Click"
                                        Visibility="Collapsed"
                                        Background="#FFF1F2" Foreground="#DC2626" BorderBrush="#FECACA"/>
                            </StackPanel>

                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0" Padding="32,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Static svc:VersionService.VersaoCompleta}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                <Button Grid.Column="1" Content="↺ Trocar usuário" Height="42" Padding="14,0"
                        Background="#FEF3C7" Foreground="#92400E" BorderBrush="#FDE68A" BorderThickness="1"
                        Style="{StaticResource SecondaryButtonStyle}" Click="BtnTrocarUsuario_Click"
                        Margin="0,0,12,0"
                        ToolTip="Limpa Nome, Ramal, Login e Senha — configurações da empresa são mantidas"/>
                <Button Grid.Column="2" Content="Cancelar" Width="110" Height="42" Style="{StaticResource SecondaryButtonStyle}" Click="BtnCancelar_Click" Margin="0,0,12,0"/>
                <Button Grid.Column="3" Content="Salvar configurações" Width="200" Height="42" Style="{StaticResource PrimaryButtonStyle}" Click="BtnSalvar_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>
