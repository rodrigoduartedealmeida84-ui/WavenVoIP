<Window x:Class="WavenVoIP.DialerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Waven VoIP - Discador"
        Height="760" Width="470"
        WindowStartupLocation="CenterScreen"
        Background="#F6F7FB">
    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#6D5EF8"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="#EEEAFE"/>
        <Style x:Key="DialButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="72"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E0E4F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Border Background="White" CornerRadius="20" Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Waven VoIP"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#191B2A"/>
                    <TextBlock Text="Discador inteligente para Issabel"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="#6E7488"/>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="#F7F8FD"
                        BorderBrush="#E3E7F3"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="12"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Status do ramal" FontWeight="SemiBold" Foreground="#2A2D3D"/>
                        <TextBlock x:Name="txtCallStatus"
                                   Text="Aguardando"
                                   Margin="0,4,0,0"
                                   Foreground="#5E647A"/>
                    </StackPanel>
                </Border>

                <TextBox Grid.Row="2"
                         x:Name="txtNumero"
                         Height="54"
                         FontSize="30"
                         TextAlignment="Center"
                         VerticalContentAlignment="Center"
                         Background="#FBFBFE"
                         BorderBrush="#DDE2F0"
                         BorderThickness="1"
                         Margin="0,0,0,14"/>

                <UniformGrid Grid.Row="3" Rows="4" Columns="3">
                    <Button Style="{StaticResource DialButtonStyle}" Content="1" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="2" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="3" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="4" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="5" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="6" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="7" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="8" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="9" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="*" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="0" Click="Tecla_Click"/>
                    <Button Style="{StaticResource DialButtonStyle}" Content="#" Click="Tecla_Click"/>
                </UniformGrid>

                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                    <Button Content="Ligar"
                            Click="Ligar_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="{StaticResource PrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"/>
                    <Button Content="Apagar"
                            Click="Apagar_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#F2F4FB"
                            Foreground="#2A2D3D"
                            BorderBrush="#DDE2F0"
                            BorderThickness="1"/>
                    <Button Content="Desligar"
                            Click="Desligar_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#FFF1F0"
                            Foreground="#A33A33"
                            BorderBrush="#F0CBC7"
                            BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
