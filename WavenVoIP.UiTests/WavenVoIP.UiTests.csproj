<Project Sdk="Microsoft.NET.Sdk">
  <!-- v2.6.0 — fotografa as telas reais em várias resoluções/escalas do Windows e confere cortes.
       Offline: não registra SIP, não consulta API/AMI/CDR, não grava configuração. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AppProj Condition="'$(AppProj)' == ''">..\WavenVoIP\WavenVoIP.csproj</AppProj>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(AppProj)" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\WavenVoIP\Assets\**\*.ico;..\WavenVoIP\Assets\**\*.png" Link="Assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
